mixin product-item(item)
    .col-12.col-sm-6.col-lg-4.mb-4
        article.product-item
            a.product-item__image(href=`/products/detail/${item.slug}` aria-label=`Xem chi tiết ${item.title}`)
                img(src=item.thumbnail, alt=item.title)
                if(item.featured == "1")
                    span.product-item__badge Nổi bật
                if(item.discountPercentage && item.discountPercentage > 0)
                    span.product-item__discount-badge -#{item.discountPercentage}%

            .product-item__content
                h3.product-item__title
                    a(href=`/products/detail/${item.slug}`) #{item.title}
                .product-item__pricing
                    span.product-item__price-new #{parseInt(item.priceNew).toLocaleString('vi-VN')}đ
                    if (item.price)
                        span.product-item__price-old #{parseInt(item.price).toLocaleString('vi-VN')}đ
                a.product-item__link(href=`/products/detail/${item.slug}`) Xem chi tiết →
