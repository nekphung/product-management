doctype html 
html 
    head 
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
        title #{pageTitle}
        link(rel="icon" href=(settingGeneral && settingGeneral.logo ? settingGeneral.logo : "/images/Logo.jpg"))

        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css")
        link(rel="stylesheet" href="/css/style.css")
        //- Thêm CSS Cropper.js
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css")
    body
        include ../partials/header.pug

        .site-main
            block main

        include ../partials/footer.pug
        include ../partials/chatbox.pug

        script(src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js")
        script(src="/js/script.js")
        script(src="/js/chatbox.js")

        //- SocketIO 
        script(src="/socket.io/socket.io.js")
        script(src="/js/socket.js")
        script(type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js")
       
        script(src="/js/chat.js")
        //- Thêm JS Cropper.js trước file script.js của bạn
        script(src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js")
