extends ../../layouts/default.pug

block main
  .container.text-center.my-5
    .row.justify-content-center
      .col-12.col-md-6
        h1.display-1.fw-bold.text-danger 404
        h2.mb-3 Not Found
        p.text-muted.mb-4 Trang bạn đang tìm kiếm không tồn tại hoặc đã bị di chuyển.
        
        button.btn.btn-primary.px-4.py-2(
          onclick="history.back()"
        ) Trở lại