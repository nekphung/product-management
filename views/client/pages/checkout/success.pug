extends ../../layouts/default.pug

block main
  main.order-success-page
    canvas#orderSuccessConfetti.order-success-confetti(aria-hidden="true")
    if (order)
      article.order-success-card
        header.order-success-card__header
          div
            p Đơn hàng đã được tiếp nhận
            h1 Đặt hàng thành công!
          a.order-success-card__close(href="/" aria-label="Về trang chủ") ×

        .order-success-card__body
          .order-success-icon(aria-hidden="true")
            svg(viewBox="0 0 64 64")
              circle(cx="32" cy="32" r="24")
              path(d="m21 32 7 7 15-16")

          h2 Chúc mừng bạn đã đặt hàng thành công!
          p.order-success-code Mã đơn hàng: #[strong ##{order._id.toString().slice(-10).toUpperCase()}]
          p.order-success-message
            | Cửa hàng đã tiếp nhận đơn hàng và sẽ liên hệ số điện thoại
            strong #{order.userInfo.phone}
            |  để xác nhận thông tin giao hàng.

          section#order-details.order-success-summary
            .order-success-summary__total
              span Tổng giá trị đơn hàng
              strong #{parseInt(order.totalPrice || 0).toLocaleString('vi-VN')}đ
            .order-success-summary__line
              span Người nhận
              strong #{order.userInfo.fullName} (#{order.userInfo.phone})
            .order-success-summary__line
              span Địa chỉ nhận
              strong #{order.userInfo.address}
            .order-success-summary__line
              span Thanh toán
              strong.order-success-summary__status #{order.userInfo.paymentMethod == "banking" ? "Chuyển khoản ngân hàng" : "Thanh toán khi nhận hàng"}
            .order-success-summary__line
              span Ngày đặt hàng
              strong #{new Date(order.createdAt).toLocaleString("vi-VN")}

          if (order.products && order.products.length > 0)
            section.order-success-products
              .order-success-products__heading
                div
                  p Chi tiết đơn hàng
                  h3 Sản phẩm đã đặt
                span #{order.products.length} sản phẩm
              .order-success-products__list
                each item in order.products
                  .order-success-product
                    .order-success-product__image
                      if (item.productInfo && item.productInfo.thumbnail)
                        img(src=item.productInfo.thumbnail alt=item.productInfo.title)
                      else
                        span 📦
                    .order-success-product__info
                      strong #{item.productInfo ? item.productInfo.title : "Sản phẩm"}
                      .order-success-product__meta
                        span Đơn giá: #{parseInt(item.priceNew || 0).toLocaleString('vi-VN')}đ
                        if (item.discountPercentage > 0)
                          span Giảm #{item.discountPercentage}%
                        span Số lượng: #{item.quantity}
                    .order-success-product__subtotal
                      span Thành tiền
                      strong #{parseInt(item.totalPrice || 0).toLocaleString('vi-VN')}đ

          .order-success-actions
            if (user)
              a.btn.order-success-actions__detail(href=`/user/orders/${order._id}`) Xem chi tiết đơn hàng
            else
              a.btn.order-success-actions__detail(href="#order-details") Xem chi tiết đơn hàng
            a.btn.order-success-actions__primary(href="/") Hoàn tất &amp; tiếp tục trải nghiệm
            a.btn.order-success-actions__secondary(href="/products") Tiếp tục mua sắm

          .order-success-assurance
            span ✓ Đơn hàng đã được ghi nhận
            span ✓ Thông tin được bảo mật

  script.
    (() => {
      const canvas = document.getElementById("orderSuccessConfetti");
      if (!canvas || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const context = canvas.getContext("2d");
      const colors = ["#7da3c7", "#8fc8ad", "#e5bd72", "#d99aa5", "#a9b8cc"];
      let pieces = [];
      let animationFrame;
      const resize = () => {
        canvas.width = window.innerWidth * window.devicePixelRatio;
        canvas.height = window.innerHeight * window.devicePixelRatio;
        canvas.style.width = `${window.innerWidth}px`;
        canvas.style.height = `${window.innerHeight}px`;
        context.setTransform(window.devicePixelRatio, 0, 0, window.devicePixelRatio, 0, 0);
      };
      const createPiece = () => ({
        x: window.innerWidth / 2 + (Math.random() - .5) * 180,
        y: Math.min(190, window.innerHeight * .22),
        width: 5 + Math.random() * 6,
        height: 3 + Math.random() * 5,
        color: colors[Math.floor(Math.random() * colors.length)],
        velocityX: (Math.random() - .5) * 9,
        velocityY: -5 - Math.random() * 7,
        gravity: .16 + Math.random() * .08,
        rotation: Math.random() * Math.PI,
        rotationSpeed: (Math.random() - .5) * .18,
        opacity: 1
      });
      resize();
      pieces = Array.from({ length: 95 }, createPiece);
      const startedAt = performance.now();
      const draw = now => {
        context.clearRect(0, 0, window.innerWidth, window.innerHeight);
        pieces.forEach(piece => {
          piece.velocityY += piece.gravity;
          piece.x += piece.velocityX;
          piece.y += piece.velocityY;
          piece.rotation += piece.rotationSpeed;
          if (now - startedAt > 2100) piece.opacity -= .018;
          context.save();
          context.globalAlpha = Math.max(0, piece.opacity);
          context.translate(piece.x, piece.y);
          context.rotate(piece.rotation);
          context.fillStyle = piece.color;
          context.fillRect(-piece.width / 2, -piece.height / 2, piece.width, piece.height);
          context.restore();
        });
        pieces = pieces.filter(piece => piece.opacity > 0 && piece.y < window.innerHeight + 30);
        if (pieces.length && now - startedAt < 3600) animationFrame = requestAnimationFrame(draw);
        else context.clearRect(0, 0, window.innerWidth, window.innerHeight);
      };
      window.addEventListener("resize", resize, { passive: true });
      animationFrame = requestAnimationFrame(draw);
      window.addEventListener("pagehide", () => cancelAnimationFrame(animationFrame), { once: true });
    })();
