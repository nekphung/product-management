extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  main.checkout-page
    .container
      header.checkout-page__heading
        p Thanh toán
        h1 #{pageTitle || "Thanh toán đơn hàng"}
        span Kiểm tra sản phẩm và thông tin nhận hàng trước khi xác nhận.

      if (cart && cart.products && cart.products.length > 0)
        form.checkout-form(action="/checkout/order" method="POST")
          input(type="hidden" name="selectedProductIds" value=cart.products.map(item => item.product_id).join(','))
          if checkoutMode === "instant"
            input(type="hidden" name="checkoutMode" value="instant")
            input(type="hidden" name="instantProductId" value=cart.products[0].product_id)
            input(type="hidden" name="instantQuantity" value=cart.products[0].quantity)

          .row.checkout-layout
            .col-lg-7.col-12
              section.checkout-card.checkout-products-card
                header.checkout-card__header
                  span.checkout-card__number 01
                  div
                    h2 Sản phẩm thanh toán
                    p #{cart.products.length} sản phẩm trong đơn hàng

                .table-responsive
                  table.checkout-products-table
                    thead
                      tr
                        th Sản phẩm
                        th Đơn giá
                        th Số lượng
                        th Tạm tính
                    tbody
                      each item in cart.products
                        tr
                          td
                            .checkout-product
                              .checkout-thumb-box
                                img.checkout-thumb-img(src=(item.productInfo && item.productInfo.thumbnail ? item.productInfo.thumbnail : '/images/default.jpg') alt=(item.productInfo && item.productInfo.title ? item.productInfo.title : 'Sản phẩm'))
                              .checkout-product-info
                                if item.productInfo
                                  a(href=`/products/detail/${item.productInfo.slug}`) #{item.productInfo.title}
                                  small Chính hãng
                                else
                                  span Sản phẩm không tồn tại
                          td.checkout-products-table__price #{item.productInfo && item.productInfo.priceNew ? Number(item.productInfo.priceNew).toLocaleString('vi-VN') : 0}đ
                          td
                            span.checkout-quantity ×#{item.quantity}
                          td.checkout-products-table__total #{Number(item.totalPrice || 0).toLocaleString('vi-VN')}đ

              section.checkout-card.checkout-summary-card
                h2 Chi tiết thanh toán
                if user
                  - const orderCoupons = couponResult.available.filter(item => (item.couponType || "order") === "order")
                  - const shippingCoupons = couponResult.available.filter(item => item.couponType === "shipping")
                  - const appliedIds = couponResult.applied.map(item => String(item._id))
                  - const walletVoucherTotal = couponResult.available.reduce((sum, item) => sum + Number(item.walletQuantity || 0), 0)
                  .checkout-voucher-picker(data-voucher-picker data-subtotal=cart.totalPrice data-shipping-fee=cart.shippingFee)
                    .checkout-voucher-picker__heading
                      div
                        span.checkout-voucher-picker__icon %
                        div
                          strong Voucher của bạn
                          small Hệ thống đã chọn ưu đãi tốt nhất
                      .checkout-voucher-picker__actions
                        span.checkout-voucher-picker__count #{walletVoucherTotal} voucher · #{couponResult.available.filter(item => item.eligible).length} loại dùng được
                        a.checkout-voucher-picker__collect(href=`/coupons?returnTo=${encodeURIComponent(checkoutReturnUrl)}`) Thu thập thêm
                    .checkout-voucher-group.checkout-voucher-group--order
                      h3
                        span Giảm giá đơn hàng
                        small Chọn tối đa 1 mã
                      label.checkout-voucher-option.checkout-voucher-option--none
                        input(type="radio" name="couponOrderId" value="" checked=!couponResult.applied.some(item => (item.couponType || "order") === "order"))
                        span.checkout-voucher-option__mark.checkout-voucher-option__mark--empty —
                        span.checkout-voucher-option__copy
                          strong Không dùng voucher
                          small Giữ nguyên giá trị đơn hàng
                      each coupon in orderCoupons
                        label.checkout-voucher-option(class=!coupon.eligible ? "is-disabled" : "" data-coupon-option data-discount=coupon.discount)
                          input(type="radio" name="couponOrderId" value=coupon._id checked=appliedIds.includes(String(coupon._id)) disabled=!coupon.eligible)
                          span.checkout-voucher-option__mark.checkout-voucher-option__mark--order %
                          span.checkout-voucher-option__copy
                            strong #{coupon.code} · #{coupon.title} · x#{coupon.walletQuantity}
                            small #{coupon.eligible ? `Giảm ${Number(coupon.discount).toLocaleString('vi-VN')}đ` : coupon.reason}
                    .checkout-voucher-group.checkout-voucher-group--shipping
                      h3
                        span Phí vận chuyển
                        small Chọn tối đa 1 mã
                      label.checkout-voucher-option.checkout-voucher-option--none
                        input(type="radio" name="couponShippingId" value="" checked=!couponResult.applied.some(item => item.couponType === "shipping"))
                        span.checkout-voucher-option__mark.checkout-voucher-option__mark--empty —
                        span.checkout-voucher-option__copy
                          strong Không dùng voucher
                          small Thanh toán đủ phí vận chuyển
                      each coupon in shippingCoupons
                        label.checkout-voucher-option(class=!coupon.eligible ? "is-disabled" : "" data-coupon-option data-discount=coupon.discount data-coupon-type="shipping" data-server-eligible=(coupon.eligible ? "true" : "false") data-discount-type=coupon.discountType data-discount-value=coupon.discountValue data-max-discount=coupon.maxDiscount)
                          input(type="radio" name="couponShippingId" value=coupon._id checked=appliedIds.includes(String(coupon._id)) disabled=!coupon.eligible)
                          span.checkout-voucher-option__mark.checkout-voucher-option__mark--shipping VC
                          span.checkout-voucher-option__copy
                            strong #{coupon.code} · #{coupon.title} · x#{coupon.walletQuantity}
                            small #{coupon.eligible ? `Giảm ${Number(coupon.discount).toLocaleString('vi-VN')}đ phí giao hàng` : coupon.reason}
                .checkout-summary-card__line
                  span Tạm tính
                  strong #{Number(cart.totalPrice || 0).toLocaleString('vi-VN')}đ
                if !user
                  .checkout-summary-card__line
                    span Voucher
                    a(href="/user/login") Đăng nhập để tự động áp dụng
                .checkout-summary-card__line
                  span Phí vận chuyển
                  strong(data-checkout-shipping) #{Number(cart.shippingFee || 0).toLocaleString('vi-VN')}đ
                .checkout-summary-card__line.checkout-summary-card__discount(data-checkout-order-discount hidden=!couponResult.orderDiscount)
                  span Giảm giá đơn hàng
                  strong -#{Number(couponResult.orderDiscount || 0).toLocaleString('vi-VN')}đ
                .checkout-summary-card__line.checkout-summary-card__discount.checkout-summary-card__discount--shipping(data-checkout-shipping-discount hidden=!couponResult.shippingDiscount)
                  span Giảm phí vận chuyển
                  strong -#{Number(couponResult.shippingDiscount || 0).toLocaleString('vi-VN')}đ
                .checkout-summary-card__total
                  span Tổng thanh toán
                  strong(data-checkout-total) #{Number(cart.finalPrice != null ? cart.finalPrice : cart.totalPrice || 0).toLocaleString('vi-VN')}đ

            .col-lg-5.col-12
              section.checkout-card.checkout-shipping-card(data-shipping-picker)
                header.checkout-recipient-card__header
                  span.checkout-card__number 02
                  div
                    h2 Phương thức vận chuyển
                    p Dữ liệu mô phỏng để hoàn thiện luồng đặt hàng
                .checkout-shipping-options
                  each method in shippingMethods
                    label.checkout-shipping-option
                      input(type="radio" name="shippingMethod" value=method.id data-shipping-fee=method.fee checked=method.id === selectedShippingMethod.id)
                      span.checkout-shipping-option__radio
                      span.checkout-shipping-option__content
                        strong #{method.name}
                        small #{method.description}
                        em #{method.provider} · #{method.eta}
                      strong.checkout-shipping-option__fee #{method.fee > 0 ? Number(method.fee).toLocaleString('vi-VN') + 'đ' : 'Miễn phí'}

              section.checkout-card.checkout-recipient-card
                header.checkout-recipient-card__header
                  span.checkout-card__number 03
                  div
                    h2 Thông tin nhận hàng
                    p Vui lòng nhập đầy đủ thông tin liên hệ

                .checkout-recipient-card__body
                  .checkout-field
                    label(for="fullName") Họ và tên #[span *]
                    input#fullName(type="text" name="fullName" placeholder="Nguyễn Văn A" value=(user ? user.fullName : '') required autocomplete="name")

                  .checkout-field
                    label(for="phone") Số điện thoại #[span *]
                    input#phone(type="tel" name="phone" placeholder="0901234567" value=(user ? user.phone : '') required autocomplete="tel")

                  .checkout-field
                    label(for="address") Địa chỉ nhận hàng #[span *]
                    textarea#address(name="address" rows="3" placeholder="Số nhà, đường, phường/xã, quận/huyện..." required autocomplete="street-address") #{user ? user.address : ''}

                  .checkout-order-note
                    span(aria-hidden="true") ✓
                    p Thông tin của bạn chỉ được sử dụng để xử lý và giao đơn hàng này.

                  button.btn-submit-order(type="submit")
                    | Xác nhận đặt hàng
                    span(aria-hidden="true") →
      else
        .checkout-empty
          span(aria-hidden="true") ◇
          h2 Chưa có sản phẩm để thanh toán
          p Hãy chọn sản phẩm trước khi tiếp tục đặt hàng.
          a(href="/products") Tiếp tục mua sắm

  script(src="/js/checkout.js")
