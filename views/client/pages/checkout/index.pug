extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  .container.my-3
    .row
      .col-12
        +box-head(pageTitle)

    if (cart && cart.products && cart.products.length > 0)
      .row
        .col-12
          table.table.table-bordered(cart-table)
            thead
              tr
                th STT
                th Ảnh
                th Tên
                th Giá
                th Số lượng
                th Tổng tiền
            tbody
              each item, index in cart.products
                tr
                  td #{index + 1}
                  td
                    img(
                      src=(item.productInfo && item.productInfo.thumbnail ? item.productInfo.thumbnail : '/images/default.jpg')
                      alt=(item.productInfo && item.productInfo.title ? item.productInfo.title : 'Sản phẩm')
                      width="80px"
                    )
                  td
                    a(href=`/products/detail/${item.productInfo ? item.productInfo.slug : ''}`) #{item.productInfo ? item.productInfo.title : 'Sản phẩm không tồn tại'}
                  td #{item.productInfo && item.productInfo.priceNew ? item.productInfo.priceNew.toLocaleString() : 0}đ
                  td #{item.quantity}
                  td #{item.totalPrice ? item.totalPrice.toLocaleString() : 0}đ

          h3.text-right.mt-3 Tổng đơn hàng: 
            span(class="text-danger") #{cart.totalPrice ? cart.totalPrice.toLocaleString() : 0}đ

      .row.mt-4
        .col-12
          .card
            .card-header.bg-primary.text-white
              h5.mb-0 Thông tin người nhận hàng
            .card-body
              form(
                action="/checkout/order"
                method="POST"
              )
                .form-group
                  label(for="fullName") Họ và tên *
                  input(
                    type="text"
                    class="form-control"
                    id="fullName"
                    name="fullName"
                    required
                  )
                .form-group
                  label(for="phone") Số điện thoại *
                  input(
                    type="text"
                    class="form-control"
                    id="phone"
                    name="phone"
                    required
                  )
                .form-group
                  label(for="address") Địa chỉ giao hàng *
                  input(
                    type="text"
                    class="form-control"
                    id="address"
                    name="address"
                    required
                  )
                .form-group.text-right
                  button(
                    type="submit"
                    class="btn btn-success btn-block mt-3"
                  ) ĐẶT HÀNG
    else
      .row
        .col-12
          p.text-center Không có sản phẩm nào trong giỏ hàng để thanh toán.