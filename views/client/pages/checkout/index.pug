extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  main.checkout-page
    .container
      header.checkout-page__heading
        p Thanh toán
        h1 #{pageTitle || "Thanh toán đơn hàng"}
        span Kiểm tra sản phẩm và thông tin nhận hàng trước khi xác nhận.

      if (cart && cart.products && cart.products.length > 0)
        form.checkout-form(action="/checkout/order" method="POST")
          input(type="hidden" name="selectedProductIds" value=cart.products.map(item => item.product_id).join(','))
          if checkoutMode === "instant"
            input(type="hidden" name="checkoutMode" value="instant")
            input(type="hidden" name="instantProductId" value=cart.products[0].product_id)
            input(type="hidden" name="instantQuantity" value=cart.products[0].quantity)

          .row.checkout-layout
            .col-lg-7.col-12
              section.checkout-card.checkout-products-card
                header.checkout-card__header
                  span.checkout-card__number 01
                  div
                    h2 Sản phẩm thanh toán
                    p #{cart.products.length} sản phẩm trong đơn hàng

                .table-responsive
                  table.checkout-products-table
                    thead
                      tr
                        th Sản phẩm
                        th Đơn giá
                        th Số lượng
                        th Tạm tính
                    tbody
                      each item in cart.products
                        tr
                          td
                            .checkout-product
                              .checkout-thumb-box
                                img.checkout-thumb-img(src=(item.productInfo && item.productInfo.thumbnail ? item.productInfo.thumbnail : '/images/default.jpg') alt=(item.productInfo && item.productInfo.title ? item.productInfo.title : 'Sản phẩm'))
                              .checkout-product-info
                                if item.productInfo
                                  a(href=`/products/detail/${item.productInfo.slug}`) #{item.productInfo.title}
                                  small Chính hãng
                                else
                                  span Sản phẩm không tồn tại
                          td.checkout-products-table__price #{item.productInfo && item.productInfo.priceNew ? Number(item.productInfo.priceNew).toLocaleString('vi-VN') : 0}đ
                          td
                            span.checkout-quantity ×#{item.quantity}
                          td.checkout-products-table__total #{Number(item.totalPrice || 0).toLocaleString('vi-VN')}đ

              section.checkout-card.checkout-summary-card
                h2 Chi tiết thanh toán
                .checkout-summary-card__line
                  span Tạm tính
                  strong #{Number(cart.totalPrice || 0).toLocaleString('vi-VN')}đ
                .checkout-summary-card__line
                  span Phí vận chuyển
                  strong.checkout-summary-card__free Miễn phí
                .checkout-summary-card__total
                  span Tổng thanh toán
                  strong #{Number(cart.totalPrice || 0).toLocaleString('vi-VN')}đ

            .col-lg-5.col-12
              section.checkout-card.checkout-recipient-card
                header.checkout-recipient-card__header
                  span.checkout-card__number 02
                  div
                    h2 Thông tin nhận hàng
                    p Vui lòng nhập đầy đủ thông tin liên hệ

                .checkout-recipient-card__body
                  .checkout-field
                    label(for="fullName") Họ và tên #[span *]
                    input#fullName(type="text" name="fullName" placeholder="Nguyễn Văn A" value=(user ? user.fullName : '') required autocomplete="name")

                  .checkout-field
                    label(for="phone") Số điện thoại #[span *]
                    input#phone(type="tel" name="phone" placeholder="0901234567" value=(user ? user.phone : '') required autocomplete="tel")

                  .checkout-field
                    label(for="address") Địa chỉ nhận hàng #[span *]
                    textarea#address(name="address" rows="3" placeholder="Số nhà, đường, phường/xã, quận/huyện..." required autocomplete="street-address") #{user ? user.address : ''}

                  .checkout-order-note
                    span(aria-hidden="true") ✓
                    p Thông tin của bạn chỉ được sử dụng để xử lý và giao đơn hàng này.

                  button.btn-submit-order(type="submit")
                    | Xác nhận đặt hàng
                    span(aria-hidden="true") →
      else
        .checkout-empty
          span(aria-hidden="true") ◇
          h2 Chưa có sản phẩm để thanh toán
          p Hãy chọn sản phẩm trước khi tiếp tục đặt hàng.
          a(href="/products") Tiếp tục mua sắm
