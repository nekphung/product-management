extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  .container.my-4
    .row.mb-3
      .col-12
        +box-head(pageTitle || "Thanh toán đơn hàng")

    if (cart && cart.products && cart.products.length > 0)
      form(action="/checkout/order", method="POST")
        .row.g-4
          //- Cột trái: Bảng sản phẩm & Tổng tiền
          .col-lg-7.col-12
            .card.border-0.shadow-sm.rounded-4.mb-4
              .card-header.bg-white.py-3.border-bottom-0
                h5.mb-0.fw-bold.text-dark
                  i.fa-solid.fa-cart-flatbed.me-2.text-primary
                  | Sản phẩm thanh toán (#{cart.products.length})
              .card-body.p-0
                .table-responsive
                  table.table.align-middle.table-hover.mb-0
                    thead.table-light
                      tr
                        th.text-center(style="width: 50px;") STT
                        th Sản phẩm
                        th.text-center Đơn giá
                        th.text-center SL
                        th.text-end Tạm tính
                    tbody
                      each item, index in cart.products
                        tr
                          td.text-center.fw-bold.text-muted #{index + 1}
                          td
                            .d-flex.align-items-center.gap-3
                              .checkout-thumb-box
                                img.checkout-thumb-img(
                                  src=(item.productInfo && item.productInfo.thumbnail ? item.productInfo.thumbnail : '/images/default.jpg')
                                  alt=(item.productInfo && item.productInfo.title ? item.productInfo.title : 'Sản phẩm')
                                )
                              .checkout-product-info
                                if (item.productInfo && item.productInfo.title)
                                  a.fw-semibold.text-dark.text-decoration-none(href=`/products/detail/${item.productInfo.slug}`) #{item.productInfo.title}
                                else
                                  span.text-muted Sản phẩm không tồn tại
                          td.text-center.text-nowrap #{item.productInfo && item.productInfo.priceNew ? item.productInfo.priceNew.toLocaleString('vi-VN') : 0}đ
                          td.text-center.fw-bold #{item.quantity}
                          td.text-end.fw-bold.text-primary.text-nowrap #{item.totalPrice ? item.totalPrice.toLocaleString('vi-VN') : 0}đ

            //- Khối tóm tắt chi phí
            .card.border-0.shadow-sm.rounded-4.p-4.bg-white
              .d-flex.justify-content-between.align-items-center.mb-2
                span.text-muted Tạm tính:
                span.fw-semibold #{cart.totalPrice ? cart.totalPrice.toLocaleString('vi-VN') : 0}đ
              .d-flex.justify-content-between.align-items-center.mb-3
                span.text-muted Phí vận chuyển:
                span.text-success.fw-semibold Miễn phí
              hr.my-2
              .d-flex.justify-content-between.align-items-center.pt-2
                span.fw-bold.fs-5 Tổng thanh toán:
                span.fw-bold.fs-3.text-danger #{cart.totalPrice ? cart.totalPrice.toLocaleString('vi-VN') : 0}đ

          //- Cột phải: Form thông tin người nhận (Sticky)
          .col-lg-5.col-12
            .card.border-0.shadow-sm.rounded-4.sticky-top(style="top: 20px; z-index: 10;")
              .card-header.bg-primary.text-white.py-3.rounded-top-4
                h5.mb-0.fw-bold
                  i.fa-solid.fa-truck-ramp-box.me-2
                  | Thông tin người nhận hàng
              .card-body.p-4
                .mb-3
                  label.form-label.fw-semibold(for="fullName") Họ và tên <span class="text-danger">*</span>
                  .input-group
                    span.input-group-text.bg-light.border-end-0
                      i.fa-solid.fa-user.text-muted
                    input#fullName.form-control.border-start-0.bg-light(
                      type="text"
                      name="fullName"
                      placeholder="Nguyễn Văn A"
                      value=(user ? user.fullName : '')
                      required
                    )
                
                .mb-3
                  label.form-label.fw-semibold(for="phone") Số điện thoại <span class="text-danger">*</span>
                  .input-group
                    span.input-group-text.bg-light.border-end-0
                      i.fa-solid.fa-phone.text-muted
                    input#phone.form-control.border-start-0.bg-light(
                      type="text"
                      name="phone"
                      placeholder="0901234567"
                      value=(user ? user.phone : '')
                      required
                    )

                .mb-4
                  label.form-label.fw-semibold(for="address") Địa chỉ nhận hàng <span class="text-danger">*</span>
                  .input-group
                    span.input-group-text.bg-light.border-end-0
                      i.fa-solid.fa-location-dot.text-muted
                    input#address.form-control.border-start-0.bg-light(
                      type="text"
                      name="address"
                      placeholder="Số nhà, đường, phường/xã, quận/huyện..."
                      value=(user ? user.address : '')
                      required
                    )

                button.btn.btn-danger.w-100.py-3.fw-bold.rounded-3.shadow-sm.btn-submit-order(type="submit")
                  i.fa-solid.fa-paper-plane.me-2
                  | XÁC NHẬN ĐẶT HÀNG
    else
      .row.justify-content-center.my-5
        .col-md-6.text-center
          .p-5.bg-white.rounded-4.shadow-sm
            i.fa-solid.fa-cart-flatbed-empty.fa-4x.text-muted.mb-3
            h4.fw-bold Giỏ hàng trống
            p.text-muted Bạn chưa có sản phẩm nào trong giỏ hàng để tiến hành thanh toán.
            a.btn.btn-primary.px-4.py-2.rounded-3.mt-2(href="/products")
              i.fa-solid.fa-arrow-left.me-2
              | Tiếp tục mua sắm

  style.
    .checkout-thumb-box {
      width: 56px;
      height: 56px;
      min-width: 56px;
      border-radius: 8px;
      background: #f8f9fa;
      border: 1px solid #e9ecef;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .checkout-thumb-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .btn-submit-order {
      font-size: 16px;
      letter-spacing: 0.5px;
      transition: all 0.2s ease;
    }
    .btn-submit-order:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(220, 53, 69, 0.3) !important;
    }
    .input-group-text {
      border-color: #dee2e6;
    }
    .form-control:focus {
      background-color: #fff !important;
      box-shadow: none;
      border-color: #86b7fe;
    }