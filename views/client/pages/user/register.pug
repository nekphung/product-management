extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)

  .client-create-page.container.my-5
    .row.justify-content-center
      .col-12.col-md-8.col-lg-5
        .card.client-create-card
          .card-header.client-create-card__header.text-center
            h3.font-weight-bold.mb-0 Đăng Ký Tài Khoản
            small.text-white-50 Tạo tài khoản mới để trải nghiệm dịch vụ

          .card-body.client-create-card__body
            form.client-create-form(
              action="/user/register"
              method="POST"
            )
              .form-group.mb-3
                label.form-label.font-weight-semibold(for="fullName") Họ và tên
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.i-user
                  input#fullName.form-control(
                    type="text"
                    name="fullName"
                    placeholder="Nguyễn Văn A"
                  )

              .form-group.mb-3
                label.form-label.font-weight-semibold(for="email") Email
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.i-envelope
                  input#email.form-control(
                    type="email"
                    name="email"
                    placeholder="example@gmail.com"
                  )

              .form-group.mb-3
                label.form-label.font-weight-semibold(for="phone") Số điện thoại
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.i-phone
                  input#phone.form-control(
                    type="text"
                    name="phone"
                    placeholder="0379xxxxxx"
                  )

              .form-group.mb-4
                label.form-label.font-weight-semibold(for="password") Mật khẩu
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.i-lock
                  input#password.form-control(
                    type="password"
                    name="password"
                    placeholder="••••••••"
                    required
                  )

              button.btn.btn-primary.btn-block.client-create-submit(type="submit")
                | Đăng ký ngay

          .card-footer.client-create-card__footer.text-center
            span.text-muted Bạn đã có tài khoản? 
            a.font-weight-bold.text-primary(href="/user/login") Đăng nhập
