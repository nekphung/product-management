extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)
  main.account-recovery
    .account-recovery__shell
      section.account-recovery__intro
        a.account-recovery__back(href="/user/password/forgot") ← Đổi địa chỉ email
        .account-recovery__illustration(aria-hidden="true") #
        p.account-recovery__eyebrow Bảo mật tài khoản
        h1 Kiểm tra email
        p Mã OTP gồm 8 chữ số đã được gửi đến email của bạn. Không cung cấp mã này cho bất kỳ ai.
        .account-recovery__security ⏱ Mã xác thực có hiệu lực trong 3 phút
      section.account-recovery__panel
        .account-recovery__steps(aria-label="Tiến trình khôi phục mật khẩu")
          .account-recovery__step.is-done
            span ✓
            small Email
          i.is-done
          .account-recovery__step.is-active
            span 2
            small Xác thực
          i
          .account-recovery__step
            span 3
            small Mật khẩu mới
        .account-recovery__heading
          span.account-recovery__heading-icon(aria-hidden="true") #
          div
            h2 Nhập mã xác thực
            p Mã được gửi đến địa chỉ bên dưới.
        form.account-recovery__form(action="/user/password/otp" method="POST")
          .account-recovery__field
            label(for="email") Email nhận mã
            .account-recovery__input-wrap.is-readonly
              span(aria-hidden="true") @
              input#email(type="email" name="email" value=email readonly)
          .account-recovery__field
            label(for="otp") Mã OTP gồm 8 chữ số
            input#otp.account-recovery__otp(type="text" name="otp" placeholder="••••••••" maxlength="8" minlength="8" required inputmode="numeric" pattern="[0-9]{8}" autocomplete="one-time-code" autofocus)
            small Nhập mã liên tục, không cần dấu cách.
          button.account-recovery__submit(type="submit") Xác nhận mã #[span(aria-hidden="true") →]
        p.account-recovery__footer Chưa nhận được mã? #[a(href="/user/password/forgot") Gửi lại mã OTP]
