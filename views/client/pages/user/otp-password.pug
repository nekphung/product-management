extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  .container.my-5
    .row.justify-content-center
      .col-12.col-md-8.col-lg-5
        .card.shadow-lg.border-0.rounded-lg
          .card-header.bg-primary.text-white.text-center.py-4
            h3.font-weight-bold.mb-1 Xác Nhận Mã OTP
            small.text-white-50 Mã OTP đã được gửi đến email của bạn

          .card-body.p-4.p-md-5
            form(
              action="/user/password/otp"
              method="POST"
            )
              //- Email người dùng (Chỉ đọc)
              .form-group.mb-3
                label.form-label.font-weight-semibold(for="email") Email nhận mã OTP
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.fa-envelope
                  input#email.form-control.bg-light(
                    type="email"
                    name="email"
                    value=email
                    readonly
                  )

              //- Nhập mã OTP
              .form-group.mb-4
                label.form-label.font-weight-semibold(for="otp") Mã xác thực OTP
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.fa-key
                  input#otp.form-control(
                    type="text"
                    name="otp"
                    placeholder="Nhập mã OTP (8 số)"
                    maxlength="8"
                    required
                    autocomplete="off"
                  )
                small.form-text.text-muted.mt-1 Mã OTP có hiệu lực trong vòng 3 phút.

              button.btn.btn-primary.btn-block.w-100.py-2.font-weight-bold.text-uppercase(type="submit")
                | Xác nhận

          .card-footer.text-center.bg-light.py-3
            span.text-muted Chưa nhận được mã? 
            a.font-weight-bold.text-primary(href=`/user/password/forgot`) Gửi lại mã