extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  .container.my-5
    .row.justify-content-center
      .col-12.col-md-8
        .card.shadow-lg.border-0.rounded-lg
          .card-header.bg-primary.text-white.text-center.py-3
            h4.font-weight-bold.mb-0 Chỉnh Sửa Thông Tin Cá Nhân

          .card-body.p-4.p-md-5
            form(
              action="/user/info/edit?_method=PATCH"
              method="POST"
              enctype="multipart/form-data"
            )
              //- Khối Avatar Căn Giữa
              .form-group.text-center.mb-4(upload-image)
                .mb-3
                  img.rounded-circle.border.shadow-sm(
                    src=(user && user.avatar ? user.avatar : "/images/avatar-default.png")
                    upload-image-preview
                    alt="Avatar Preview"
                    style="width: 140px; height: 140px; object-fit: cover;"
                  )

                div
                  label.btn.btn-outline-primary.btn-sm.mb-0(for="avatarInput")
                    i.fas.fa-camera.mr-1
                    span Thay đổi ảnh

                  //- Input chọn file ẩn (kích hoạt Popup)
                  input#avatarInput.d-none(
                    type="file"
                    accept="image/*"
                    upload-image-input
                  )

                  //- Input ẩn gửi file đã crop lên Server
                  input#croppedAvatarFile.d-none(
                    type="file"
                    name="avatar"
                  )

              .row
                .col-md-6
                  .form-group.mb-3
                    label.form-label.font-weight-semibold(for="fullName") Họ và tên
                    input#fullName.form-control(
                      type="text"
                      name="fullName"
                      value=(user ? user.fullName : "")
                      required
                    )

                .col-md-6
                  .form-group.mb-3
                    label.form-label.font-weight-semibold(for="email") Email
                    input#email.form-control.bg-light(
                      type="email"
                      name="email"
                      value=(user ? user.email : "")
                      readonly
                    )

              .row
                .col-md-6
                  .form-group.mb-3
                    label.form-label.font-weight-semibold(for="phone") Số điện thoại
                    input#phone.form-control(
                      type="text"
                      name="phone"
                      value=(user ? user.phone : "")
                    )

                .col-md-6
                  .form-group.mb-3
                    label.form-label.font-weight-semibold(for="address") Địa chỉ
                    input#address.form-control(
                      type="text"
                      name="address"
                      value=(user ? user.address : "")
                    )

              .d-flex.justify-content-between.align-items-center.mt-4
                a.btn.btn-secondary.px-4(href="/user/info") Hủy bỏ
                button.btn.btn-primary.px-4.font-weight-bold(type="submit") Lưu thay đổi

  //- Pop-up Modal Cắt/Chỉnh Ảnh (Đã sửa lại chuẩn thụt lùi)
  #cropImageModal.modal.fade(tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static" data-bs-backdrop="static")
    .modal-dialog.modal-dialog-centered(role="document")
      .modal-content
        .modal-header
          h5.modal-title Chỉnh sửa ảnh đại diện
          button.close.btn-close(type="button" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close")
            span(aria-hidden="true") &times;
        .modal-body.text-center
          .img-container(style="max-height: 400px; overflow: hidden;")
            img#imageToCrop(src="" style="max-width: 100%; display: block;")
        .modal-footer
          button.btn.btn-secondary(type="button" data-dismiss="modal" data-bs-dismiss="modal") Hủy
          button#cropAndSaveBtn.btn.btn-primary(type="button") Áp dụng & Lưu