extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  .client-create-page.container.my-5
    .row.justify-content-center
      .col-12.col-md-8.col-lg-5
        .card.client-create-card
          .card-header.client-create-card__header.text-center
            h3.font-weight-bold.mb-0 Đăng Nhập
            small.text-white-50 Vui lòng đăng nhập để tiếp tục

          .card-body.client-create-card__body
            form.client-create-form(
              action="/user/login"
              method="POST"
            )
              .form-group.mb-3
                label.form-label.font-weight-semibold(for="email") Email
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.fa-envelope
                  input#email.form-control(
                    type="email"
                    name="email"
                    placeholder="example@gmail.com"
                  )

              .form-group.mb-3
                label.form-label.font-weight-semibold(for="password") Mật khẩu
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.fa-lock
                  input#password.form-control(
                    type="password"
                    name="password"
                    placeholder="••••••••"
                  )

              .client-login-options.d-flex.justify-content-between.align-items-center.mb-4
                .form-check
                  input#remember.form-check-input(type="checkbox" name="remember")
                  label.form-check-label.small(for="remember") Ghi nhớ đăng nhập
                a.small.text-primary(href="/user/password/forgot") Quên mật khẩu?

              button.btn.btn-primary.btn-block.client-create-submit(type="submit")
                | Đăng nhập

          .card-footer.client-create-card__footer.text-center
            span.text-muted Chưa có tài khoản? 
            a.font-weight-bold.text-primary(href="/user/register") Đăng ký ngay
