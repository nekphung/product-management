extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  main.account-profile
    .container
      .account-profile__card
        header.account-profile__header
          p.account-profile__eyebrow Tài khoản của bạn
          h1 Thông tin cá nhân

        section.account-profile__hero
          .account-profile__pattern(aria-hidden="true")
          img.account-profile__avatar(src=(user && user.avatar ? user.avatar : "/images/chat-support-avatar.png") alt=(user && user.fullName ? user.fullName : "Ảnh đại diện"))
          h2 #{user.fullName || "Người dùng"}
          p #{user.email || "Chưa cập nhật email"}

        .account-profile__divider
          span NP

        section.account-profile__details(aria-label="Chi tiết tài khoản")
          .account-profile__field
            .account-profile__field-label
              svg(viewBox="0 0 24 24" aria-hidden="true")
                circle(cx="12" cy="8" r="4")
                path(d="M4 21a8 8 0 0 1 16 0")
              span Họ và tên
            strong #{user.fullName || "Chưa cập nhật"}
          .account-profile__field
            .account-profile__field-label
              svg(viewBox="0 0 24 24" aria-hidden="true")
                rect(x="3" y="5" width="18" height="14" rx="2")
                path(d="m3 7 9 6 9-6")
              span Email
            strong #{user.email || "Chưa cập nhật"}
          .account-profile__field
            .account-profile__field-label
              svg(viewBox="0 0 24 24" aria-hidden="true")
                path(d="M7 3h4l2 5-3 2a15 15 0 0 0 4 4l2-3 5 2v4a4 4 0 0 1-4 4C9 21 3 15 3 7a4 4 0 0 1 4-4Z")
              span Số điện thoại
            strong #{user.phone || "Chưa cập nhật"}
          .account-profile__field
            .account-profile__field-label
              svg(viewBox="0 0 24 24" aria-hidden="true")
                path(d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z")
                circle(cx="12" cy="10" r="2.5")
              span Địa chỉ
            strong #{user.address || "Chưa cập nhật"}

        footer.account-profile__actions
          a.btn.account-profile__home(href="/")
            svg(viewBox="0 0 24 24" aria-hidden="true")
              path(d="m3 11 9-8 9 8")
              path(d="M5 10v11h14V10M9 21v-7h6v7")
            span Trang chủ
          a.btn.account-profile__edit(href="/user/info/edit")
            span Chỉnh sửa thông tin
            svg(viewBox="0 0 24 24" aria-hidden="true")
              path(d="M12 20h9")
              path(d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z")
