extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(3000)
  +alert-error(3000)

  .container.my-5
    .row.justify-content-center
      .col-12.col-md-8.col-lg-5
        .reset-card
          //- Header xanh dương
          .reset-header
            h2.reset-title Đặt Lại Mật Khẩu
            p.reset-subtitle Vui lòng nhập mật khẩu mới cho tài khoản của bạn

          //- Body chứa Form
          .reset-body
            form(
              action="/user/password/reset"
              method="POST"
            )
              //- Mật khẩu mới
              .mb-3
                label.form-label.reset-label(for="password") Mật khẩu mới
                .input-group
                  input#password.form-control.reset-input(
                    type="password"
                    name="password"
                    placeholder="Nhập mật khẩu mới"
                    required
                  )
                  button#togglePassword.btn.btn-outline-secondary.btn-toggle-eye(type="button")
                    i.fa-solid.fa-eye

              //- Xác nhận mật khẩu
              .mb-4
                label.form-label.reset-label(for="confirmPassword") Xác nhận mật khẩu
                .input-group
                  input#confirmPassword.form-control.reset-input(
                    type="password"
                    name="confirmPassword"
                    placeholder="Nhập lại mật khẩu mới"
                    required
                  )
                  button#toggleConfirmPassword.btn.btn-outline-secondary.btn-toggle-eye(type="button")
                    i.fa-solid.fa-eye

              //- Nút Xác nhận
              button.btn.reset-btn-submit(type="submit") ĐỔI MẬT KHẨU

          //- Footer quay lại đăng nhập
          .reset-footer
            span Bạn đã nhớ lại mật khẩu? 
            a.reset-login-link(href="/user/login") Đăng nhập ngay

  style.
    body {
      background-color: #f4f6f8;
    }

    .reset-card {
      background: #ffffff;
      border-radius: 4px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      border: 1px solid #e2e8f0;
    }

    /* Header xanh nổi bật */
    .reset-header {
      background-color: #007bff;
      color: #ffffff;
      text-align: center;
      padding: 30px 20px;
    }
    .reset-title {
      font-size: 26px;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .reset-subtitle {
      font-size: 15px;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 0;
    }

    /* Form body */
    .reset-body {
      padding: 30px 35px;
    }
    .reset-label {
      font-size: 15px;
      color: #333333;
      margin-bottom: 6px;
    }
    .reset-input {
      height: 44px;
      font-size: 15px;
      border: 1px solid #dcdcdc;
      color: #333333;
    }
    .reset-input:focus {
      border-color: #80bdff;
      box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }
    
    .btn-toggle-eye {
      border-color: #dcdcdc;
      color: #666;
    }

    /* Nút bấm xanh */
    .reset-btn-submit {
      width: 100%;
      height: 46px;
      background-color: #007bff;
      color: #ffffff;
      font-weight: 700;
      font-size: 16px;
      border: none;
      border-radius: 4px;
      transition: background-color 0.2s ease;
    }
    .reset-btn-submit:hover {
      background-color: #0056b3;
      color: #ffffff;
    }

    /* Footer xám nhạt */
    .reset-footer {
      background-color: #f8f9fa;
      border-top: 1px solid #eeeeee;
      padding: 16px 20px;
      text-align: center;
      font-size: 15px;
      color: #555555;
    }
    .reset-login-link {
      color: #007bff;
      font-weight: 700;
      text-decoration: none;
      margin-left: 4px;
    }
    .reset-login-link:hover {
      text-decoration: underline;
    }

  script.
    // Script bật/tắt ẩn hiện mật khẩu
    const setupTogglePassword = (inputId, btnId) => {
      const input = document.getElementById(inputId);
      const btn = document.getElementById(btnId);
      if (input && btn) {
        btn.addEventListener("click", () => {
          const icon = btn.querySelector("i");
          const isPassword = input.type === "password";
          input.type = isPassword ? "text" : "password";
          icon.classList.toggle("fa-eye", !isPassword);
          icon.classList.toggle("fa-eye-slash", isPassword);
        });
      }
    };

    setupTogglePassword("password", "togglePassword");
    setupTogglePassword("confirmPassword", "toggleConfirmPassword");