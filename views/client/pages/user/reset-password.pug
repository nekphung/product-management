extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(3000)
  +alert-error(5000)
  main.account-recovery
    .account-recovery__shell
      section.account-recovery__intro
        a.account-recovery__back(href="/user/login") ← Quay lại đăng nhập
        .account-recovery__illustration(aria-hidden="true") 🔒
        p.account-recovery__eyebrow Bước cuối cùng
        h1 Tạo mật khẩu mới
        p Chọn mật khẩu dễ nhớ với bạn nhưng khó đoán với người khác để bảo vệ tài khoản.
        .account-recovery__security ✓ Nên sử dụng ít nhất 8 ký tự
      section.account-recovery__panel
        .account-recovery__steps(aria-label="Tiến trình khôi phục mật khẩu")
          .account-recovery__step.is-done
            span ✓
            small Email
          i.is-done
          .account-recovery__step.is-done
            span ✓
            small Xác thực
          i.is-done
          .account-recovery__step.is-active
            span 3
            small Mật khẩu mới
        .account-recovery__heading
          span.account-recovery__heading-icon(aria-hidden="true") ✦
          div
            h2 Đặt lại mật khẩu
            p Hai mật khẩu cần phải giống nhau.
        form.account-recovery__form(action="/user/password/reset" method="POST")
          .account-recovery__field
            label(for="password") Mật khẩu mới
            .account-recovery__input-wrap
              span(aria-hidden="true") ●
              input#password(type="password" name="password" placeholder="Nhập mật khẩu mới" minlength="8" required autocomplete="new-password" autofocus)
              button.account-recovery__toggle(type="button" data-password-toggle="password" aria-label="Hiện mật khẩu") Hiện
          .account-recovery__field
            label(for="confirmPassword") Xác nhận mật khẩu
            .account-recovery__input-wrap
              span(aria-hidden="true") ●
              input#confirmPassword(type="password" name="confirmPassword" placeholder="Nhập lại mật khẩu mới" minlength="8" required autocomplete="new-password")
              button.account-recovery__toggle(type="button" data-password-toggle="confirmPassword" aria-label="Hiện mật khẩu") Hiện
          button.account-recovery__submit(type="submit") Hoàn tất đổi mật khẩu #[span(aria-hidden="true") →]
        p.account-recovery__footer Bạn đã nhớ mật khẩu? #[a(href="/user/login") Đăng nhập ngay]
  script.
    document.querySelectorAll("[data-password-toggle]").forEach(button => {
      button.addEventListener("click", () => {
        const input = document.getElementById(button.dataset.passwordToggle);
        const shouldShow = input.type === "password";
        input.type = shouldShow ? "text" : "password";
        button.textContent = shouldShow ? "Ẩn" : "Hiện";
        button.setAttribute("aria-label", shouldShow ? "Ẩn mật khẩu" : "Hiện mật khẩu");
      });
    });
