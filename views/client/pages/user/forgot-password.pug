extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)
  main.account-recovery
    .account-recovery__shell
      section.account-recovery__intro
        a.account-recovery__back(href="/user/login") ← Quay lại đăng nhập
        .account-recovery__illustration(aria-hidden="true") ✉
        p.account-recovery__eyebrow Khôi phục tài khoản
        h1 Quên mật khẩu?
        p Đừng lo, chúng tôi sẽ gửi mã xác thực đến email của bạn để đặt lại mật khẩu an toàn.
        .account-recovery__security ✓ Mã xác thực chỉ có hiệu lực trong 3 phút
      section.account-recovery__panel
        .account-recovery__steps(aria-label="Tiến trình khôi phục mật khẩu")
          .account-recovery__step.is-active
            span 1
            small Email
          i
          .account-recovery__step
            span 2
            small Xác thực
          i
          .account-recovery__step
            span 3
            small Mật khẩu mới
        .account-recovery__heading
          span.account-recovery__heading-icon(aria-hidden="true") @
          div
            h2 Xác nhận email
            p Nhập email đã dùng để đăng ký tài khoản.
        form.account-recovery__form(action="/user/password/forgot" method="POST")
          .account-recovery__field
            label(for="email") Địa chỉ email
            .account-recovery__input-wrap
              span(aria-hidden="true") @
              input#email(type="email" name="email" placeholder="ban@example.com" required autocomplete="email" autofocus)
            small Chúng tôi không chia sẻ email của bạn với bất kỳ ai.
          button.account-recovery__submit(type="submit") Gửi mã OTP #[span(aria-hidden="true") →]
        p.account-recovery__footer Bạn đã nhớ mật khẩu? #[a(href="/user/login") Đăng nhập ngay]
