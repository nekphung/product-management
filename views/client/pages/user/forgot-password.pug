extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  .container.my-5
    .row.justify-content-center
      .col-12.col-md-8.col-lg-5
        .card.shadow-lg.border-0.rounded-lg
          .card-header.bg-primary.text-white.text-center.py-4
            h3.font-weight-bold.mb-0 Quên Mật Khẩu
            small.text-white-50 Nhập email để nhận mã xác thực OTP

          .card-body.p-4.p-md-5
            form(
              action="/user/password/forgot"
              method="POST"
            )
              .form-group.mb-4
                label.form-label.font-weight-semibold(for="email") Địa chỉ Email
                .input-group
                  .input-group-prepend
                    span.input-group-text
                      i.fas.fa-envelope
                  input#email.form-control(
                    type="email"
                    name="email"
                    placeholder="example@gmail.com"
                  )

              button.btn.btn-primary.btn-block.w-100.py-2.font-weight-bold.text-uppercase(type="submit")
                | Gửi mã xác nhận (OTP)

          .card-footer.text-center.bg-light.py-3
            a.font-weight-bold.text-primary(href="/user/login")
              i.fas.fa-arrow-left.mr-1
              | Quay lại đăng nhập