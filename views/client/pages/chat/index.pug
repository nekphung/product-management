extends ../../layouts/default.pug

block main
  style.
    .chat-page{min-height:calc(100vh - 66px);padding:38px 0 58px;background:linear-gradient(180deg,#f2f6fa 0,#f8fafc 100%);color:#172033}.chat-page__heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;max-width:940px;margin:0 auto 20px}.chat-page__eyebrow{margin:0 0 5px;color:#47749d;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.chat-page h1{margin:0;color:#172033;font-size:30px;font-weight:850;line-height:1.2}.chat-page__heading>p{max-width:540px;margin:0;color:#7d8b9b;font-size:11px;line-height:1.55;text-align:right;white-space:nowrap}.chat{max-width:940px;margin:0 auto;overflow:hidden;border:1px solid #d8e3ec;border-radius:18px;background:#fff;box-shadow:0 18px 45px rgba(15,23,42,.09)}.chat .inner-head{display:flex;min-height:76px;align-items:center;gap:12px;padding:14px 20px;border-bottom:1px solid #e4eaf0;background:#fff}.chat .inner-avatar{position:relative;display:grid;width:46px;height:46px;flex:0 0 46px;place-items:center;overflow:hidden;border:2px solid #dce8f2;border-radius:50%;background:#e5eef6;color:#315f89;font-size:15px;font-weight:800}.chat .inner-avatar:after{position:absolute;right:1px;bottom:1px;width:9px;height:9px;border:2px solid #fff;border-radius:50%;background:#42a66f;content:""}.chat .inner-avatar img{width:100%;height:100%;object-fit:cover}.chat .inner-head .inner-name{color:#24364a;font-size:14px;font-weight:800}.chat .inner-status{display:flex;align-items:center;gap:5px;margin-top:3px;color:#538367;font-size:9px}.chat .inner-status:before{width:6px;height:6px;border-radius:50%;background:#43a970;content:""}.chat .inner-body{height:500px;overflow-y:auto;padding:24px;background:linear-gradient(145deg,#f8fafc,#f3f7fa);scrollbar-color:#c5d2de transparent;scrollbar-width:thin}.chat .inner-incoming,.chat .inner-outgoing{display:flex;margin-bottom:15px;flex-direction:column}.chat .inner-incoming{align-items:flex-start}.chat .inner-outgoing{align-items:flex-end}.chat .inner-body .inner-name{margin:0 0 5px 4px;color:#758496;font-size:9px;font-weight:750}.chat .inner-content{position:relative;max-width:70%;padding:10px 14px;border:1px solid #e0e7ed;border-radius:5px 15px 15px;background:#fff;color:#33475b;font-size:13px;line-height:1.55;word-break:break-word;box-shadow:0 3px 10px rgba(15,23,42,.04)}.chat .inner-outgoing .inner-content{border-color:#47749d;border-radius:15px 5px 15px 15px;background:#47749d;color:#fff;box-shadow:0 5px 13px rgba(71,116,157,.2)}.chat .inner-foot{padding:13px 15px;border-top:1px solid #e3e9ef;background:#fff}.chat .inner-form{display:flex;align-items:flex-end;gap:10px}.chat .inner-input{flex:1;min-height:44px;max-height:110px;resize:none;padding:11px 13px;border:1px solid #d3dee8;border-radius:11px;background:#f9fbfc;color:#334155;font:inherit;font-size:13px;line-height:20px;outline:0;transition:border-color .18s,box-shadow .18s,background .18s}.chat .inner-input:focus{border-color:#6f94b5;background:#fff;box-shadow:0 0 0 3px rgba(71,116,157,.1)}.chat .inner-button{display:grid;width:44px;height:44px;flex:0 0 44px;place-items:center;border:0;border-radius:11px;background:#47749d;color:#fff;cursor:pointer;box-shadow:0 6px 14px rgba(71,116,157,.2);transition:background .18s,transform .18s}.chat .inner-button:hover{background:#3b668d;transform:translateY(-1px)}.chat .inner-button svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.chat-page__privacy{max-width:940px;margin:12px auto 0;color:#98a4b1;font-size:9px;text-align:center}@media(max-width:991.98px){.chat-page__heading{align-items:flex-start;flex-direction:column;gap:7px}.chat-page__heading>p{text-align:left;white-space:normal}}@media(max-width:767.98px){.chat-page{padding:24px 0 38px}.chat{border-radius:14px}.chat .inner-body{height:calc(100vh - 340px);min-height:390px;padding:18px 14px}.chat .inner-content{max-width:82%}}@media(max-width:575.98px){.chat-page{padding:16px 0 28px}.chat-page h1{font-size:25px}.chat-page__heading>p{display:none}.chat .inner-head{min-height:68px;padding:11px 14px}.chat .inner-avatar{width:42px;height:42px;flex-basis:42px}.chat .inner-body{height:calc(100vh - 282px);min-height:360px;padding:15px 11px}.chat .inner-content{max-width:88%;font-size:12px}.chat .inner-foot{padding:10px}.chat .inner-input,.chat .inner-button{min-height:42px;height:42px}}

  main.chat-page
    .container
      .chat-page__heading
        div
          p.chat-page__eyebrow Trò chuyện cộng đồng
          h1 Tin nhắn
        p Kết nối và trò chuyện trực tiếp với những khách hàng khác trong cộng đồng.

      .chat(my-id=user.id)
        .inner-head
          .inner-avatar
            if (user.avatar)
                img(src=user.avatar alt="")
            else
                #{user.fullName ? user.fullName.charAt(0).toUpperCase() : "U"}
          div
            .inner-name #{user.fullName}
            .inner-status Đang hoạt động

        .inner-body
            each chat in chats
                div(class=(chat.infoUser.id == user.id ? "inner-outgoing" : "inner-incoming"))
                    if(chat.infoUser.id != user.id)
                        .inner-name #{chat.infoUser.fullName}
                    .inner-content
                        | #{chat.content}
        //-   .inner-incoming
        //-     .inner-message-name Người dùng
        //-     .inner-content Xin chào, rất vui được trò chuyện với bạn.

        //-   .inner-outgoing
        //-     .inner-content Chào bạn! Mình cũng vậy.

        .inner-foot
          form.inner-form(action="" data-chat-form)
            textarea.inner-input(
              name="content"
              rows="1"
              maxlength="2000"
              placeholder="Nhập nội dung..."
              autocomplete="off"
            )
            button.inner-button(type="submit" aria-label="Gửi tin nhắn")
              svg(viewBox="0 0 24 24" aria-hidden="true")
                path(d="m22 2-7 20-4-9-9-4z")
                path(d="M22 2 11 13")

      p.chat-page__privacy Không chia sẻ mật khẩu hoặc thông tin thanh toán trong cuộc trò chuyện.
