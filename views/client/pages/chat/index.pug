extends ../../layouts/default.pug

block main
  style.
    .chat-page{padding:40px 0 60px;background:#f6f8fb}.chat-page h1{margin:0 0 22px;color:#172033;font-size:30px;font-weight:800}.chat{max-width:820px;overflow:hidden;border:1px solid #dce4ec;border-radius:14px;background:#fff;box-shadow:0 10px 28px rgba(15,23,42,.08)}.chat .inner-head{display:flex;align-items:center;gap:11px;padding:14px 18px;border-bottom:1px solid #e5eaf0;background:#f9fbfc}.chat .inner-avatar{display:grid;width:42px;height:42px;place-items:center;overflow:hidden;border-radius:50%;background:#e5eef6;color:#3f6f99;font-weight:800}.chat .inner-avatar img{width:100%;height:100%;object-fit:cover}.chat .inner-name{color:#293b50;font-size:13px;font-weight:750}.chat .inner-status{margin-top:2px;color:#4f8a69;font-size:9px}.chat .inner-body{height:440px;overflow-y:auto;padding:20px;background:#f7f9fb}.chat .inner-incoming,.chat .inner-outgoing{display:flex;margin-bottom:14px;flex-direction:column}.chat .inner-incoming{align-items:flex-start}.chat .inner-outgoing{align-items:flex-end}.chat .inner-message-name{margin-bottom:4px;color:#64748b;font-size:10px;font-weight:700}.chat .inner-content{max-width:72%;padding:10px 13px;border-radius:5px 14px 14px;background:#e9edf1;color:#334155;font-size:13px;line-height:1.5;word-break:break-word}.chat .inner-outgoing .inner-content{border-radius:14px 5px 14px 14px;background:#47749d;color:#fff}.chat .inner-foot{padding:12px;border-top:1px solid #e5eaf0;background:#fff}.chat .inner-form{display:flex;align-items:flex-end;gap:9px}.chat .inner-input{flex:1;min-height:42px;max-height:100px;resize:none;padding:10px 12px;border:1px solid #d4dfe8;border-radius:10px;color:#334155;font:inherit;font-size:13px;outline:0}.chat .inner-input:focus{border-color:#6f94b5;box-shadow:0 0 0 3px rgba(71,116,157,.1)}.chat .inner-button{display:grid;width:42px;height:42px;flex:0 0 42px;place-items:center;border:0;border-radius:10px;background:#47749d;color:#fff;cursor:pointer}.chat .inner-button:hover{background:#3d678e}.chat .inner-button svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}@media(max-width:575.98px){.chat-page{padding:22px 0 38px}.chat-page h1{font-size:25px}.chat{border-radius:11px}.chat .inner-body{height:calc(100vh - 310px);min-height:360px;padding:15px 12px}.chat .inner-content{max-width:84%}}

  main.chat-page
    .container
      h1 Chat

      .chat
        .inner-head
          .inner-avatar
            img(src="/images/chat-support-avatar.png" alt="Ảnh đại diện")
          div
            .inner-name Người dùng
            .inner-status Đang hoạt động

        .inner-body(data-chat-body)
          .inner-incoming
            .inner-message-name Người dùng
            .inner-content Xin chào, rất vui được trò chuyện với bạn.

          .inner-outgoing
            .inner-content Chào bạn! Mình cũng vậy.

        .inner-foot
          form.inner-form(action="" data-chat-form)
            textarea.inner-input(
              name="content"
              rows="1"
              maxlength="2000"
              placeholder="Nhập nội dung..."
              autocomplete="off"
              required
              data-chat-input
            )
            button.inner-button(type="submit" aria-label="Gửi tin nhắn")
              svg(viewBox="0 0 24 24" aria-hidden="true")
                path(d="m22 2-7 20-4-9-9-4z")
                path(d="M22 2 11 13")
