extends ../../layouts/default.pug
include ../../mixins/box-head.pug 
include ../../mixins/product-layout.pug 

block main
  main.home-page
    section.home-hero
      .container
        .row.align-items-center
          .col-12.col-lg-7
            .home-hero__content
              p.home-hero__eyebrow Mua sắm thông minh mỗi ngày
              h1 Khám phá sản phẩm phù hợp với bạn
              p.home-hero__description Chọn nhanh những sản phẩm nổi bật, cập nhật mới và được yêu thích tại cửa hàng.
              .home-hero__actions
                a.btn.btn-primary.btn-lg(href="/products") Khám phá sản phẩm
                a.btn.btn-outline-primary.btn-lg(href="#featured-products") Xem nổi bật
              .home-hero__trust
                span ✓ Sản phẩm rõ ràng
                span ✓ Đặt hàng nhanh
                span ✓ Hỗ trợ tận tâm
          .col-12.col-lg-5
            .home-hero__visual
              .home-hero__glow(aria-hidden="true")
              if (productsFeatued && productsFeatued.length > 0)
                - const heroProduct = productsFeatued[0]
                a.home-hero-product(href=`/products/detail/${heroProduct.slug}`)
                  .home-hero-product__top
                    span Sản phẩm nổi bật
                    if (heroProduct.discountPercentage && heroProduct.discountPercentage > 0)
                      strong -#{heroProduct.discountPercentage}%
                  .home-hero-product__image
                    img(src=heroProduct.thumbnail alt=heroProduct.title)
                  h2 #{heroProduct.title}
                  .home-hero-product__price
                    strong #{parseInt(heroProduct.priceNew).toLocaleString('vi-VN')}đ
                    span Xem chi tiết →
              else
                .home-hero-product.home-hero-product--empty
                  span Sản phẩm mới mỗi ngày
                  strong Chọn đúng, mua dễ
              .home-hero__floating-badge
                span.home-hero__floating-icon ✓
                div
                  strong Giao hàng nhanh
                  small An tâm mua sắm

    section#featured-products.home-section
      .container
        .home-section__heading
          div
            p.home-section__eyebrow Được quan tâm nhất
            h2 Sản phẩm nổi bật
          a.home-section__link(href="/products") Xem tất cả →
        +product-grid(productsFeatued)

    section.home-section.home-section--soft
      .container
        .home-section__heading
          div
            p.home-section__eyebrow Vừa cập nhật
            h2 Sản phẩm mới
          a.home-section__link(href="/products") Xem tất cả →
        +product-grid(productsNew)
