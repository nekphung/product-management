extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug 

block main
  .container.my-4
    .row.mb-3
      .col-12
        +box-head(pageTitle)
    
    +alert-success(2000)

    .row
      .col-12
        if (cart.products.length > 0)
          .card.border-0.shadow-sm.rounded-4.overflow-hidden.mb-4
            .card-body.p-0
              .table-responsive
                table.table.table-bordered.align-middle.mb-0(cart-table)
                  thead.table-light
                    tr
                      th.text-center(style="width: 50px;") STT
                      th.text-center(style="width: 100px;") Ảnh
                      th Tên
                      th.text-center Đơn giá
                      th.text-center(style="width: 140px;") Số lượng
                      th.text-end Tổng tiền
                      th.text-center(style="width: 100px;") Hành động
                  tbody
                    each item, index in cart.products
                      tr
                        td.text-center.fw-bold.text-muted #{index + 1}
                        td.text-center
                          .cart-thumb-box.mx-auto
                            img.cart-thumb-img(
                              src=(item.productInfo && item.productInfo.thumbnail ? item.productInfo.thumbnail : '/images/default.jpg') 
                              alt=(item.productInfo && item.productInfo.title ? item.productInfo.title : 'Sản phẩm') 
                            )
                        td
                          if (item.productInfo && item.productInfo.title)
                            a.fw-semibold.text-dark.text-decoration-none(href=`/products/detail/${item.productInfo.slug}`) #{item.productInfo.title}
                          else
                            span.text-muted Sản phẩm không tồn tại
                        td.text-center.text-nowrap #{item.productInfo && item.productInfo.priceNew ? item.productInfo.priceNew.toLocaleString('vi-VN') : 0}đ
                        
                        //- Khối tăng/giảm số lượng (-) (+)
                        td.text-center
                          .cart-quantity-box.d-inline-flex.align-items-center
                            button.btn-qty.btn-minus(type="button") -
                            input.cart-quantity-input(
                              type="number"
                              name="quantity"
                              value=item.quantity
                              min="1"
                              item-id=item.product_id
                            )
                            button.btn-qty.btn-plus(type="button") +

                        td.text-end.fw-bold.text-primary.text-nowrap #{item.totalPrice ? item.totalPrice.toLocaleString('vi-VN') : 0}đ
                        td.text-center
                          a.btn.btn-danger.btn-sm.px-3(
                            href=`/cart/delete/${item.product_id}`
                          ) Xóa

          //- Khối Tổng đơn hàng & Nút Thanh toán
          .card.border-0.shadow-sm.rounded-4.p-4.bg-white
            .d-flex.flex-column.align-items-end.gap-3
              h3.mb-0.fw-bold Tổng đơn hàng: 
                span.text-danger #{cart.totalPrice ? cart.totalPrice.toLocaleString('vi-VN') : 0}đ

              a.btn.btn-success.btn-lg.px-5.fw-bold.shadow-sm(
                href="/checkout"
              ) THANH TOÁN
        else
          .card.border-0.shadow-sm.rounded-4.p-5.text-center
            p.text-muted.fs-5.mb-0 Không có sản phẩm nào trong giỏ hàng.

  script(src="/js/cart.js")

    