extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(2000)

  main.cart-page
    .container.py-4.py-md-5
      nav.cart-breadcrumb(aria-label="breadcrumb")
        ol.breadcrumb.mb-3
          li.breadcrumb-item
            a(href="/") Trang chủ
          li.breadcrumb-item.active(aria-current="page") Giỏ hàng

      .cart-page-heading
        .cart-page-heading__copy
          p.cart-page-heading__eyebrow Đơn hàng của bạn
          h1.cart-page-heading__title #{pageTitle}
          if (cart.products.length > 0)
            p.cart-page-heading__description Bạn đang có #{cart.products.length} sản phẩm trong giỏ hàng.
          else
            p.cart-page-heading__description Hãy chọn những sản phẩm bạn yêu thích để tiếp tục.
        a.btn.btn-outline-primary.cart-page-heading__continue(href="/products") Tiếp tục mua sắm

      if (cart.products.length > 0)
        .row
          .col-12.col-lg-8.mb-4.mb-lg-0
            .cart-items-card
              .cart-items-card__header
                h2.cart-items-card__title Sản phẩm đã chọn
                span.cart-items-card__count #{cart.products.length} sản phẩm

              .table-responsive.d-none.d-md-block
                table.table.cart-table.mb-0(cart-table)
                  thead
                    tr
                      th Sản phẩm
                      th.text-center Đơn giá
                      th.text-center Số lượng
                      th.text-right Tạm tính
                      th
                  tbody
                    each item in cart.products
                      tr
                        td
                          .cart-product
                            a.cart-product__image(href=`/products/detail/${item.productInfo.slug}`)
                              img(src=(item.productInfo && item.productInfo.thumbnail ? item.productInfo.thumbnail : '/images/default.jpg') alt=(item.productInfo && item.productInfo.title ? item.productInfo.title : 'Sản phẩm'))
                            .cart-product__info
                              a.cart-product__name(href=`/products/detail/${item.productInfo.slug}`) #{item.productInfo.title}
                              if (item.productInfo.discountPercentage)
                                span.cart-product__discount -#{item.productInfo.discountPercentage}%
                        td.text-center.text-nowrap
                          span.cart-table__price #{item.productInfo.priceNew.toLocaleString('vi-VN')}đ
                        td.text-center
                          .cart-quantity-box.d-inline-flex.align-items-center
                            button.btn-qty.btn-minus(type="button" aria-label="Giảm số lượng") −
                            input.cart-quantity-input(type="number" name="quantity" value=item.quantity min="1" item-id=item.product_id aria-label=`Số lượng ${item.productInfo.title}`)
                            button.btn-qty.btn-plus(type="button" aria-label="Tăng số lượng") +
                        td.text-right.text-nowrap
                          strong.cart-table__total #{item.totalPrice.toLocaleString('vi-VN')}đ
                        td.text-right
                          a.cart-remove(href=`/cart/delete/${item.product_id}` aria-label=`Xóa ${item.productInfo.title} khỏi giỏ hàng`) Xóa

              .cart-mobile-items.d-md-none
                each item in cart.products
                  article.cart-mobile-item
                    .cart-mobile-item__top
                      a.cart-product__image(href=`/products/detail/${item.productInfo.slug}`)
                        img(src=(item.productInfo && item.productInfo.thumbnail ? item.productInfo.thumbnail : '/images/default.jpg') alt=(item.productInfo && item.productInfo.title ? item.productInfo.title : 'Sản phẩm'))
                      .cart-mobile-item__info
                        a.cart-product__name(href=`/products/detail/${item.productInfo.slug}`) #{item.productInfo.title}
                        span.cart-table__price #{item.productInfo.priceNew.toLocaleString('vi-VN')}đ
                        if (item.productInfo.discountPercentage)
                          span.cart-product__discount -#{item.productInfo.discountPercentage}%
                    .cart-mobile-item__bottom
                      .cart-quantity-box.d-inline-flex.align-items-center
                        button.btn-qty.btn-minus(type="button" aria-label="Giảm số lượng") −
                        input.cart-quantity-input(type="number" name="quantity" value=item.quantity min="1" item-id=item.product_id aria-label=`Số lượng ${item.productInfo.title}`)
                        button.btn-qty.btn-plus(type="button" aria-label="Tăng số lượng") +
                      .text-right
                        strong.cart-table__total #{item.totalPrice.toLocaleString('vi-VN')}đ
                        a.cart-remove.d-block.mt-2(href=`/cart/delete/${item.product_id}`) Xóa

          .col-12.col-lg-4
            aside.cart-summary-card
              h2.cart-summary-card__title Tóm tắt đơn hàng
              .cart-summary-card__line
                span Tạm tính
                span #{cart.totalPrice.toLocaleString('vi-VN')}đ
              .cart-summary-card__line
                span Phí giao hàng
                span.cart-summary-card__free Miễn phí
              .cart-summary-card__total
                span Tổng cộng
                strong #{cart.totalPrice.toLocaleString('vi-VN')}đ
              a.btn.btn-primary.btn-block.cart-summary-card__checkout(href="/checkout") Tiến hành thanh toán
              p.cart-summary-card__note Thanh toán an toàn. Bạn có thể kiểm tra lại thông tin ở bước tiếp theo.

            .cart-support-card
              h2.cart-support-card__title Mua sắm an tâm
              ul.cart-support-card__list
                li
                  strong Giao hàng nhanh
                  span Hỗ trợ giao hàng toàn quốc
                li
                  strong Thanh toán thuận tiện
                  span Xác nhận đơn hàng ở bước tiếp theo
                li
                  strong Hỗ trợ khách hàng
                  span Liên hệ chúng tôi khi cần trợ giúp
      else
        .cart-empty-state.text-center
          span.cart-empty-state__icon(aria-hidden="true") 🛒
          h2 Giỏ hàng của bạn đang trống
          p Khám phá các sản phẩm mới và thêm món phù hợp vào giỏ hàng.
          a.btn.btn-primary(href="/products") Khám phá sản phẩm

  script(src="/js/cart.js")
