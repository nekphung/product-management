extends ../../layouts/default.pug 
include ../../mixins/alert.pug 

block main 
    +alert-success(2000)
    
    style.
        .client-product-detail {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            padding: 30px;
            margin-top: 20px;
        }
        .client-img-wrapper {
            width: 100%;
            height: 400px;
            border-radius: 12px;
            overflow: hidden;
            background: #f8f9fa;
            border: 1px solid #f1f3f5;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .client-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.3s ease;
        }
        .client-img:hover {
            transform: scale(1.03);
        }

        /* Danh mục sản phẩm */
        .category-badge {
            display: inline-flex;
            align-items: center;
            background-color: #e6f7ff;
            color: #1890ff;
            border: 1px solid #91d5ff;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .category-badge:hover {
            background-color: #1890ff;
            color: #fff;
        }

        /* Khối hiển thị giá hiện đại */
        .client-price-box {
            background: linear-gradient(135deg, #fff5f5 0%, #fff0f0 100%);
            padding: 18px 24px;
            border-radius: 12px;
            border: 1px solid #ffe3e3;
            margin: 20px 0;
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }
        .price-new-client {
            font-size: 32px;
            font-weight: 800;
            color: #e50914;
            letter-spacing: -0.5px;
            line-height: 1;
        }
        .price-old-client {
            font-size: 16px;
            color: #8c8c8c;
            text-decoration: line-through;
            font-weight: 500;
        }
        .badge-discount-client {
            background: #e50914;
            color: #ffffff;
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 13px;
            box-shadow: 0 2px 8px rgba(229, 9, 20, 0.25);
        }

        /* Tình trạng hàng */
        .stock-status {
            font-size: 14px;
            color: #555;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
        }

        /* Cụm mua hàng & Số lượng */
        .purchase-action-group {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .input-quantity-custom {
            width: 75px !important;
            height: 48px !important;
            text-align: center;
            border-radius: 10px !important;
            border: 1.5px solid #e0e0e0;
            font-weight: 600;
            font-size: 16px;
            outline: none;
            transition: all 0.2s;
        }
        .input-quantity-custom:focus {
            border-color: #e50914;
            box-shadow: 0 0 0 3px rgba(229, 9, 20, 0.1);
        }

        .btn-add-cart {
            height: 48px;
            background-color: #fff0f1;
            color: #e50914;
            border: 1.5px solid #ffccd1;
            font-weight: 600;
            padding: 0 24px;
            border-radius: 10px;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .btn-add-cart:hover {
            background-color: #ffe0e3;
            color: #d0000d;
            border-color: #ffb3b9;
        }

        .btn-buy-now {
            height: 48px;
            background: linear-gradient(135deg, #ff4d4f 0%, #e50914 100%);
            color: #fff !important;
            font-weight: 600;
            padding: 0 32px;
            border-radius: 10px;
            border: none;
            box-shadow: 0 4px 14px rgba(229, 9, 20, 0.3);
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }
        .btn-buy-now:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(229, 9, 20, 0.4);
        }

        /* Mô tả sản phẩm */
        .desc-title {
            font-size: 20px;
            font-weight: 700;
            color: #262626;
            border-left: 4px solid #e50914;
            padding-left: 12px;
            margin-bottom: 15px;
        }
        .desc-body {
            color: #434343;
            line-height: 1.8;
            font-size: 16px;
        }

    .container.my-4 
        if (product)
            //- Tiêu đề sản phẩm
            .row 
                .col-12 
                    h1(class="mb-3 text-start font-weight-bold" style="color: #262626; font-size: 28px;") #{product.title}
            
            //- Khối thông tin sản phẩm
            .client-product-detail
                .row
                    //- Cột trái: Ảnh sản phẩm
                    .col-md-5.col-12.mb-4.mb-md-0
                        if (product.thumbnail)
                            .client-img-wrapper
                                img(
                                    src=product.thumbnail
                                    alt=product.title
                                    class="client-img"
                                )
                        else 
                            .client-img-wrapper
                                span.text-muted Không có hình ảnh sản phẩm

                    //- Cột phải: Thông tin & Mua hàng
                    .col-md-7.col-12
                        //- Danh mục sản phẩm (nếu có)
                        if (product.category)
                            div.mb-3
                                span.text-muted.me-2 Danh mục:
                                a(
                                    href=`/products/${product.category.slug}` 
                                    class="category-badge"
                                ) 🏷️ #{product.category.title}

                        //- Khối hiển thị giá
                        .client-price-box
                            if (product.discountPercentage && product.discountPercentage > 0)
                                span.price-new-client #{parseInt(product.priceNew).toLocaleString('vi-VN')}đ
                                span.price-old-client #{parseInt(product.price).toLocaleString('vi-VN')}đ
                                span.badge-discount-client -#{product.discountPercentage}%
                            else if (product.price)
                                span.price-new-client #{parseInt(product.price).toLocaleString('vi-VN')}đ

                        //- Tình trạng hàng
                        if (product.stock > 0)
                            .stock-status
                                i(class="fa-solid fa-circle-check me-2 text-success")
                                | Tình trạng: 
                                span.text-success.font-weight-bold.ms-1 Còn hàng (#{product.stock} sản phẩm)
                        else 
                            .stock-status
                                i(class="fa-solid fa-circle-xmark me-2 text-danger")
                                | Tình trạng: 
                                span.text-danger.font-weight-bold.ms-1 Hết hàng

                        //- Cụm chọn số lượng & Nút mua
                        if (product.stock > 0)
                            form(
                                action=`/cart/add/${product.id}`
                                method="POST"
                                class="purchase-action-group my-4"
                            )
                                input(
                                    type="number"
                                    name="quantity"
                                    value="1"
                                    min="1"
                                    max=product.stock
                                    class="form-control input-quantity-custom"
                                )
                                button(
                                    type="submit" 
                                    class="btn btn-add-cart"
                                )
                                    i(class="fa-solid fa-cart-plus")
                                    span Thêm vào giỏ hàng
                                
                                a(
                                    href=`/checkout/instant/${product.id}` 
                                    class="btn btn-buy-now"
                                ) Mua ngay

                //- Khối mô tả sản phẩm
                if (product.description)
                    .row.mt-5
                        .col-12.pt-4(style="border-top: 1px solid #f0f0f0;")
                            h3.desc-title Thông tin chi tiết sản phẩm
                            .desc-body !{product.description}
        else 
            .row
                .col-12
                    h1.mb-4.text-center Chi tiết sản phẩm
                    .alert.alert-warning.text-center(style="max-width: 500px; margin: 30px auto;")
                        | 🏷️ Sản phẩm hiện không tồn tại hoặc đã bị ẩn. 
                        br
                        a(href="/products" class="alert-link mt-2 d-inline-block") Quay lại danh sách sản phẩm