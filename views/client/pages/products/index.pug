extends ../../layouts/default.pug

block main
  main.product-listing-page
    .container.py-4.py-md-5
      nav.product-breadcrumb(aria-label="breadcrumb")
        ol.breadcrumb.mb-3
          li.breadcrumb-item
            a(href="/") Trang chủ
          li.breadcrumb-item.active(aria-current="page") Sản phẩm

      .product-listing-heading
        .product-listing-heading__copy
          p.product-listing-heading__eyebrow Khám phá cửa hàng
          h1.product-listing-heading__title #{pageTitle}
          p.product-listing-heading__description Chọn sản phẩm phù hợp với nhu cầu của bạn.
        p.product-listing-heading__count.mb-0
          span.sr-only Tổng số sản phẩm:
          strong #{products ? products.length : 0}
          |  sản phẩm

      if (products && products.length > 0)
        .row
          each item in products
            .col-12.col-sm-6.col-lg-4.mb-4
              article.product-listing-card.h-100
                a.product-listing-card__image(href=`/products/detail/${item.slug}` aria-label=`Xem chi tiết ${item.title}`)
                  img(src=item.thumbnail alt=item.title)
                  if (item.featured == "1")
                    span.product-listing-card__badge Nổi bật

                .product-listing-card__body
                  h2.product-listing-card__title
                    a(href=`/products/detail/${item.slug}`) #{item.title}

                  .product-listing-card__price
                    span.product-listing-card__price-current #{parseInt(item.priceNew).toLocaleString('vi-VN')}đ
                    if (item.price)
                      span.product-listing-card__price-old #{parseInt(item.price).toLocaleString('vi-VN')}đ

                  .product-listing-card__footer
                    if (item.discountPercentage)
                      span.product-listing-card__discount -#{item.discountPercentage}%
                    a.btn.btn-outline-primary.btn-sm.product-listing-card__action(href=`/products/detail/${item.slug}`) Xem chi tiết
      else
        .product-listing-empty.text-center
          .product-listing-empty__icon(aria-hidden="true")
            span ✦
          h2 Chưa có sản phẩm
          p Danh mục này đang được cập nhật. Trong lúc chờ đợi, bạn có thể xem các sản phẩm khác hoặc quay về trang chủ.
          .product-listing-empty__actions
            a.btn.btn-primary(href="/products") Xem tất cả sản phẩm
            a.btn.btn-outline-primary(href="/") Về trang chủ
