include ../mixins/sub-menu.pug

header.site-header
  .container
    nav.navbar.navbar-expand-lg.p-0
      a.site-brand(href="/")
        img(src=settingGeneral.logo, alt="Trang chủ")
        span.site-brand__name #{settingGeneral.websiteName}
      button.navbar-toggler.site-nav-toggle(type="button" data-toggle="collapse" data-target="#siteNavigation" aria-controls="siteNavigation" aria-expanded="false" aria-label="Mở menu") Menu
      #siteNavigation.collapse.navbar-collapse
        form.site-search(action="/search" method="GET")
          input.form-control(type="search" placeholder="Tìm sản phẩm" name="keyword" value=keyword aria-label="Tìm sản phẩm")
          button.site-search__button(type="submit" aria-label="Tìm kiếm")
            svg(viewBox="0 0 24 24" aria-hidden="true")
              circle(cx="11" cy="11" r="7")
              path(d="m20 20-4-4")
        ul.navbar-nav.site-nav
          li.nav-item
            a.nav-link(href="/") Trang chủ
          li.nav-item.sub-menu
            - const pathProduct = "/products"
            button.nav-link.site-products-toggle(type="button" data-product-menu-toggle aria-expanded="false")
              | Sản phẩm
              span.site-products-toggle__arrow(aria-hidden="true") ▾
            +sub-menu(layoutProductsCategory, pathProduct, true)
          if (user)
            li.nav-item
              a.nav-link.site-cart-link(href="/chat")
                svg.site-cart-icon(viewBox="0 0 24 24" aria-hidden="true")
                  path(d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z")
                  path(d="M8 9h8M8 13h5")
                span Tin nhắn
          li.nav-item
            a.nav-link.site-cart-link(href="/cart")
              svg.site-cart-icon(viewBox="0 0 24 24" aria-hidden="true")
                circle(cx="9" cy="20" r="1.5")
                circle(cx="18" cy="20" r="1.5")
                path(d="M2 3h3l2.4 11.2a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L22 7H6")
              span Giỏ hàng
              span.site-cart-count #{miniCart ? miniCart.totalQuantity : "0"}
          if (user)
            li.nav-item.dropdown
              a.nav-link.dropdown-toggle.site-account(href="#" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false")
                span.site-account__avatar(aria-hidden="true")
                  if (user.avatar)
                    img(src=user.avatar alt="")
                  else
                    | #{user.fullName ? user.fullName.charAt(0).toUpperCase() : "U"}
                span.site-account__name #{user.fullName}
              .dropdown-menu.dropdown-menu-right.site-user-menu
                .site-user-menu__header
                  span.site-user-menu__avatar
                    if (user.avatar)
                      img(src=user.avatar alt="")
                    else
                      | #{user.fullName ? user.fullName.charAt(0).toUpperCase() : "U"}
                  div
                    strong #{user.fullName}
                    small Tài khoản khách hàng
                a.dropdown-item(href="/user/info")
                  span.site-user-menu__icon
                    svg(viewBox="0 0 24 24" aria-hidden="true")
                      circle(cx="12" cy="8" r="4")
                      path(d="M4 21a8 8 0 0 1 16 0")
                  | Thông tin tài khoản
                a.dropdown-item(href="/user/info/edit")
                  span.site-user-menu__icon
                    svg(viewBox="0 0 24 24" aria-hidden="true")
                      path(d="M12 20h9")
                      path(d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z")
                  | Chỉnh sửa tài khoản
                a.dropdown-item(href="/user/orders")
                  span.site-user-menu__icon
                    svg(viewBox="0 0 24 24" aria-hidden="true")
                      path(d="M6 8h12l-1 12H7L6 8Z")
                      path(d="M9 8V6a3 3 0 0 1 6 0v2")
                  | Đơn hàng của tôi
                a.dropdown-item(href="/user/password/reset")
                  span.site-user-menu__icon
                    svg(viewBox="0 0 24 24" aria-hidden="true")
                      circle(cx="8" cy="15" r="4")
                      path(d="m11 12 9-9M17 6l3 3M14 9l3 3")
                  | Đổi mật khẩu
                .dropdown-divider
                a.dropdown-item.text-danger(href="/user/logout")
                  span.site-user-menu__icon
                    svg(viewBox="0 0 24 24" aria-hidden="true")
                      path(d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5")
                      path(d="m15 8 4 4-4 4M19 12H9")
                  | Đăng xuất
          else
            li.nav-item
              a.btn.btn-outline-light.btn-sm.site-login(href="/user/login") Đăng nhập
            li.nav-item
              a.btn.btn-light.btn-sm.site-register(href="/user/register") Đăng ký
