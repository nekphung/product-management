extends ../../layouts/default.pug

block main
  .admin-page-heading
    div
      p.admin-page-eyebrow Quản trị hệ thống
      h1 Trang tổng quan
      p Theo dõi nhanh tình trạng dữ liệu và tài khoản trong hệ thống.

  .dashboard-profile-card
    if user.avatar
      img.dashboard-profile-card__avatar.dashboard-profile-card__avatar--image(src=user.avatar alt=`Ảnh đại diện của ${user.fullName || "quản trị viên"}` onerror="this.hidden=true;this.nextElementSibling.hidden=false")
      .dashboard-profile-card__avatar(hidden) #{user.fullName ? user.fullName.charAt(0).toUpperCase() : "A"}
    else
      .dashboard-profile-card__avatar #{user.fullName ? user.fullName.charAt(0).toUpperCase() : "A"}
    .dashboard-profile-card__content
      span Tài khoản đang đăng nhập
      h2 #{user.fullName || "Quản trị viên"}
      .dashboard-profile-card__meta
        if(user.email)
          span #{user.email}
        if(user.phone)
          span #{user.phone}
        if(role.title)
          span.dashboard-role-badge #{role.title}

  .dashboard-stat-grid
    each statCard in [{ label: "Danh mục sản phẩm", mark: "DM", caption: "Tổng danh mục", data: statistic.categoryProduct, color: "blue" }, { label: "Sản phẩm", mark: "SP", caption: "Tổng sản phẩm", data: statistic.product, color: "green" }, { label: "Tài khoản admin", mark: "AD", caption: "Tổng quản trị viên", data: statistic.account, color: "purple" }, { label: "Tài khoản khách hàng", mark: "KH", caption: "Tổng khách hàng", data: statistic.user, color: "orange" }]
      .dashboard-stat-card(class=`dashboard-stat-card--${statCard.color}`)
        .dashboard-stat-card__top
          span #{statCard.label}
          span.dashboard-stat-card__mark #{statCard.mark}
        strong.dashboard-stat-card__total #{statCard.data.total}
        span.dashboard-stat-card__caption #{statCard.caption}
        .dashboard-stat-card__footer
          span Hoạt động: <b>#{statCard.data.active}</b>
          span Dừng: <b>#{statCard.data.inactive}</b>
