extends ../../layouts/default.pug
include ../../mixins/alert.pug 

block main
  if (role.permissions.includes("roles_permissions"))
    .admin-permissions-toolbar
      div
        p.admin-permissions-toolbar__eyebrow Quản lý truy cập
        h1.admin-permissions-title Phân quyền vai trò
        p.admin-permissions-toolbar__description Chọn các chức năng mà từng nhóm tài khoản được phép sử dụng.
      button.admin-permissions-save(
        type="submit"
        class="btn btn-primary"
        button-submit
      )
        | Cập nhật

    +alert-success(5000)
    +alert-error(5000)

    if (records)
      div(data-records=records)

      table(
        class="table table-hover table-sm admin-permissions-table"
        table-permissions
      )
        thead
          tr
            th Tính năng
            each item in records
              th(class="text-center") #{item.title}
        tbody
          tr(data-name="id" class="d-none")
            td
            each item in records
              td(class="text-center")
                input(type="text" value=item.id)

          //- Danh mục sản phẩm
          tr
            td(colspan=records.length + 1)
              b Danh mục sản phẩm

          tr(data-name="products-category_view")
            td Xem
            each item in records
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="products-category_create")
            td Thêm mới
            each item in records
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="products-category_edit")
            td Chỉnh sửa
            each item in records
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="products-category_delete")
            td Xóa
            each item in records
              td(class="text-center")
                input(type="checkbox")

          //- Sản phẩm
          tr
            td(colspan=records.length + 1)
              b Sản phẩm

          tr(data-name="products_view")
            td Xem
            each item in records
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="products_create")
