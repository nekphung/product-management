            each item in records
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="products_edit")
            td Chỉnh sửa
            each item in records
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="products_delete")
            td Xóa
            each item in records
              td(class="text-center")
                input(type="checkbox")

          //- Quản lý đơn hàng
          tr
            td(colspan=records.length + 1)
              b Quản lý đơn hàng

          tr(data-name="orders_view")
            td Xem
            each item in records
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="orders_edit")
            td Cập nhật trạng thái / Sửa
            each item in records
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="orders_delete")
