                input(type="checkbox")

          tr(data-name="roles_edit")
            td Chỉnh sửa
            each item in records
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="roles_delete")
            td Xóa
            each item in records
              td(class="text-center")
