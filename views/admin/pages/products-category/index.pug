extends ../../layouts/default.pug
include ../../mixins/table-tree.pug 


block main 
    h1 Danh mục sản phẩm 

    .card.mb-3 
        .card-header Danh sách  
        .card-body 
            .row.mb-3
                .col-8 
                .col-4 
                    a(
                        href=`${prefixAdmin}/products-category/create`
                        class="btn btn-outline-success"
                    ) + Thêm mới 

            table(
                class="table table-hover table-sm"
                checkbox-multi
            )
                thead
                    tr
                        th STT
                        th Hình ảnh
                        th Tiêu đề
                        th Vị trí
                        th Trạng thái
                        th Hành động

                tbody
                    if(records && records.length > 0)
                        +table-tree(records)
                    else
                        tr
                            td(colspan="6" class="text-center") Chưa có danh mục nào được tạo.