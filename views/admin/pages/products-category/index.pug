extends ../../layouts/default.pug
include ../../mixins/table-tree.pug 

block main 
    if (role.permissions.includes("products-category_view"))
        h1 Danh mục sản phẩm 

        .card.mb-3 
            .card-header.admin-list-header
                span Danh sách
                if (role.permissions.includes("products-category_create"))
                    a.admin-create-button(href=`${prefixAdmin}/products-category/create`)
                        span.admin-create-button__icon(aria-hidden="true") +
                        | Thêm mới
            .card-body 
                table(
                    class="table table-hover table-sm"
                    checkbox-multi
                )
                    thead
                        tr
                            th STT
                            th Hình ảnh
                            th Tiêu đề
                            th Vị trí
                            th Trạng thái
                            th Hành động

                    tbody
                        if(records && records.length > 0)
                            +table-tree(records)
                        else
                            tr
                                td(colspan="6" class="text-center") Chưa có danh mục nào được tạo.
