extends ../../layouts/default.pug

block main
  .admin-profile-page
    .admin-profile-page__heading
      div
        p.admin-page-eyebrow Tài khoản quản trị
        h1 Thông tin cá nhân
        p Xem và quản lý hồ sơ tài khoản đang đăng nhập.
      a.btn.btn-primary(href=`${prefixAdmin}/my-account/edit`) Chỉnh sửa thông tin

    .admin-profile-card
      .admin-profile-card__summary
        img(src=(user.avatar ? user.avatar : "/admin/images/avatar.png") alt=user.fullName)
        div
          h2 #{user.fullName || "Chưa cập nhật tên"}
          p #{user.email || "Chưa cập nhật email"}
          if (user.status === "active")
            span.badge.badge-success Hoạt động
          else
            span.badge.badge-danger Dừng hoạt động
      .admin-profile-card__details
        .admin-profile-detail
          span Họ và tên
          strong #{user.fullName || "Chưa cập nhật"}
        .admin-profile-detail
          span Email
          strong #{user.email || "Chưa cập nhật"}
        .admin-profile-detail
          span Số điện thoại
          strong #{user.phone || "Chưa cập nhật"}
        .admin-profile-detail
          span Vai trò
          strong #{role.title || "Chưa phân quyền"}
