extends ../../layouts/default.pug
//- include ../../mixins/box-head.pug

block main
  h1.mb-4 Thông tin cá nhân

  if (user.avatar)
    div(class="mb-4")
      img(
        src=user.avatar
        width="150px"
        class="rounded-circle shadow-sm"
        style="height: 150px; object-fit: cover;"
      )
  else
    div(class="mb-4")
      img(
        src="/admin/images/avatar.png"
        width="150px"
        class="rounded-circle shadow-sm"
        style="height: 150px; object-fit: cover;"
      )

  if (user.fullName)
    p.mb-3 Họ tên: <b>#{user.fullName}</b>

  if (user.email)
    p.mb-3 Email: <b>#{user.email}</b>

  if (user.phone)
    p.mb-3 Số điện thoại: <b>#{user.phone}</b>

  p.mb-3
    span Trạng thái: 
    span
      if (user.status === "active")
        span(class="badge bg-success") Hoạt động
      else
        span(class="badge bg-danger") Dừng hoạt động

  if (role.title)
    p.mb-4 Phân quyền: <b>#{role.title}</b>

  a(
    href=`${prefixAdmin}/my-account/edit`
    class="btn btn-primary"
  ) Chỉnh sửa thông tin