extends ../../layouts/default.pug 
include ../../mixins/alert.pug 

block main 
  h1(class="mb-4") Chỉnh sửa thông tin cá nhân

  +alert-error(5000)
  +alert-success(5000)

  form(
    action=`${prefixAdmin}/my-account/edit?_method=PATCH`
    method="POST"
    enctype="multipart/form-data"
  ) 
    // Họ tên 
    div(class="form-group mb-3")
      label(for="fullName") Họ tên *
      input(
        type="text"
        class="form-control"
        id="fullName"
        name="fullName"
        required
        value=user.fullName
      )

    // Email
    div(class="form-group mb-3")
      label(for="email") Email *
      input(
        type="email"
        class="form-control"
        id="email"
        name="email"
        required
        value=user.email 
      )

    // Mật khẩu (Lưu ý: Không bắt buộc required khi chỉnh sửa)
    div(class="form-group mb-3")
      label(for="password") Mật khẩu
      input(
        type="password"
        class="form-control"
        id="password"
        name="password"
        placeholder="Bỏ trống nếu không muốn đổi mật khẩu"
      )

    // Số điện thoại
    div(class="form-group mb-3")
      label(for="phone") Số điện thoại
      input(
        type="text"
        class="form-control"
        id="phone"
        name="phone"
        value=user.phone
      )

    // Avatar 
    div(
      class="form-group mb-3"
      upload-image
    )
      label(for="avatar") Avatar
      input( 
        type="file" 
        class="form-control-file d-block"
        id="avatar" 
        name="avatar" 
        accept="image/*" 
        upload-image-input
      )
      img(
        src=(user.avatar ? user.avatar : "/admin/images/avatar.png")
        upload-image-preview
        class="image-preview"
        style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; margin-top: 10px;"
      )

    // Nút submit 
    div(class="form-group mt-3")
      button.btn.btn-primary(type="submit") Cập nhật