//- extends ../../layouts/auth.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  .container.my-5
    .row.justify-content-center
      .col-8
        h1(class="text-center mb-4") Đăng nhập
        form(
          action=`${prefixAdmin}/auth/login`
          method="POST"
        )
          div(class="form-group mb-3")
            label(for="email") Email *
            input(
              type="email"
              class="form-control"
              id="email"
              name="email"
              required
            )
          div(class="form-group mb-3")
            label(for="password") Mật khẩu *
            input(
              type="password"
              class="form-control"
              id="password"
              name="password"
              required
            )
          div(class="form-group text-center mt-4")
            button(
              type="submit"
              class="btn btn-primary btn-block"
            ) Đăng nhập