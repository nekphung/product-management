extends ../../layouts/default.pug 
include ../../mixins/alert.pug 

block main 
  h1(class="mb-4") Cập nhật tài khoản

  +alert-error(5000)
  +alert-success(5000)

  if roles && roles.length > 0
    form(
      action=`${prefixAdmin}/accounts/edit/${data._id}?_method=PATCH`
      method="POST"
      enctype="multipart/form-data"
    ) 
      // Họ tên 
      div(class="form-group mb-3")
        label(for="fullName") Họ tên *
        input(
          type="text"
          class="form-control"
          id="fullName"
          name="fullName"
          required
          value=data.fullName
        )

      // Email
      div(class="form-group mb-3")
        label(for="email") Email *
        input(
          type="email"
          class="form-control"
          id="email"
          name="email"
          required
          value=data.email 
        )

      // Mật khẩu (Lưu ý: Không bắt buộc required khi chỉnh sửa)
      div(class="form-group mb-3")
        label(for="password") Mật khẩu
        input(
          type="password"
          class="form-control"
          id="password"
          name="password"
          placeholder="Bỏ trống nếu không muốn đổi mật khẩu"
        )

      // Số điện thoại
      div(class="form-group mb-3")
        label(for="phone") Số điện thoại
        input(
          type="text"
          class="form-control"
          id="phone"
          name="phone"
          value=data.phone
        )

      // Avatar (Sửa name="thumbnail" thành name="avatar")
      div(
        class="form-group mb-3"
        upload-image
      )
        label(for="avatar") Avatar
        input( 
          type="file" 
          class="form-control-file d-block"
          id="avatar" 
          name="avatar" 
          accept="image/*" 
          upload-image-input
        )
        img(
          src=data.avatar
          upload-image-preview
          class="image-preview"
          style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; margin-top: 10px;"
        )

      // Phân quyền
      div(class="form-group mb-3")
        label(for="role_id") Phân quyền
        select(
          name="role_id"
          id="role_id"
          class="form-control"
        )
          option(disabled) -- Chọn -- 
          each item in roles 
            option(
              value=item.id 
              selected=(item.id == data.role_id ? true : false)
            ) #{item.title}

      // Trạng thái
      div(class="form-group form-check form-check-inline mb-3")
        input(
          type="radio"
          class="form-check-input"
          id="statusActive"
          name="status"
          value="active"
          checked=(data.status === "active" ? true : false)
        )
        label(for="statusActive" class="form-check-label") Hoạt động

      div(class="form-group form-check form-check-inline mb-3")
        input(
          type="radio"
          class="form-check-input"
          id="statusInActive"
          name="status"
          value="inactive"
          checked=(data.status === "inactive" ? true : false)
        )
        label(for="statusInActive" class="form-check-label") Dừng hoạt động

      // Nút submit 
      div(class="form-group mt-3")
        button.btn.btn-primary(type="submit") Cập nhật
  else 
    p Vui lòng tạo nhóm quyền trước khi cập nhật tài khoản 
    p 
      a(href=`${prefixAdmin}/roles/create` class="btn btn-secondary") Tạo nhóm quyền