extends ../../layouts/default.pug

block main 
  if (role.permissions.includes("accounts_view"))
    h1(class="mb-4") Danh sách tài khoản 

    .card.mb-3 
      .card-header.admin-list-header
        span Danh sách
        if (role.permissions.includes("accounts_create"))
          a.admin-create-button(href=`${prefixAdmin}/accounts/create`)
            span.admin-create-button__icon(aria-hidden="true") +
            | Thêm mới
      .card-body 
        table(class="table table-hover table-sm")
          thead
            tr
              th STT
              th Avatar
              th Họ tên
              th Phân quyền 
              th Email
              th Trạng thái
              th Hành động
          tbody
            if (records && records.length > 0)
              each item, index in records
                tr
                  td #{index + 1}
                  td
                    if (item.avatar)
                      img(
                        src=item.avatar
                        alt=item.fullName
                        width="40px"
                        height="40px"
                        style="border-radius: 50%; object-fit: cover;"
                      )
                    else
                      //- Hiển thị ảnh mặc định nếu tài khoản không có avatar
                      img(
                        src="/admin/images/default-avatar.png" 
                        alt=item.fullName
                        width="40px"
                        height="40px"
                        style="border-radius: 50%; object-fit: cover;"
                      )
                  td #{item.fullName}

                  //- Hiển thị tên vai trò (Tùy theo Cách 1 hay Cách 2 ở Controller)
                  //- Cách 1 (dùng populate): item.role_id.title
                  //- Cách 2 (gán record.role): item.role ? item.role.title : ''
                  td #{item.role.title}

                  td #{item.email}

                  td
                    if (role.permissions.includes("accounts_edit"))
                      if (item.status === "active")
                        span(class="badge badge-success") Hoạt động
                      else
                        span(class="badge badge-danger") Dừng hoạt động
                  td
                    a(
                      href=`${prefixAdmin}/accounts/detail/${item._id}`
                      class="btn btn-secondary btn-sm mr-1"
                    ) Chi tiết
                    if (role.permissions.includes("accounts_edit"))
                      a(
                        href=`${prefixAdmin}/accounts/edit/${item._id}`
                        class="btn btn-warning btn-sm mr-1"
                      ) Sửa
                    if (role.permissions.includes("accounts_delete"))
                      button(
                        class="btn btn-danger btn-sm"
                        data-id=item._id
                      ) Xóa
            else
              tr
                //- Cập nhật colspan="8" vì đã thêm 1 cột
                td.admin-empty-state(colspan="8")
                  span.admin-empty-state__icon(aria-hidden="true") ∅
                  strong Chưa có tài khoản
                  small Tài khoản mới sẽ hiển thị tại đây sau khi được tạo.
