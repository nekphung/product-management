extends ../../layouts/default.pug 
include ../../mixins/alert.pug 

block main 
    +alert-error(5000)

    h1(class="mb-4") Thêm mới sản phẩm 

    form(
        action=`${prefixAdmin}/products/create`
        id="form-create-product"
        method="POST"
        enctype="multipart/form-data"
    ) 
        // Tiêu đề 
        div(class="form-group")
            label(for="title") Tiêu đề 
            input(
                type="text"
                class="form-control"
                id="title"
                name="title"
                
            )

        // Mô tả 
        div(class="form-group") 
            label(for="desc") Mô tả 
            textarea(
                class="form-control textarea-mce"
                id="desc"
                name="description"
                rows="5"
            )
        
        // Mô tả 
        div(class="form-group") 
            label(for="desc") Nội dung  
            textarea(
                class="form-control textarea-mce"
                id="contentabc"
                name="contentabc"
                rows="5"
            )

        // Giá 
        .form-group
            label(for="price") Giá 
            input( 
                type="number"
                class="form-control" 
                id="price" 
                name="price" 
                value="0"
                min="0" 
            )
        
        // Giảm giá 
        .form-group
            label(for="discount") Giảm giá (%) 
            input( 
                type="number" 
                class="form-control"
                id="discount" 
                name="discountPercentage" 
                value="0" 
                min="0"
                step="any"
            )

        // Số lượng 
        .form-group
            label(for="stock") Số lượng 
            input( 
                type="number" 
                class="form-control"
                id="stock" 
                name="stock" 
                min="0" 
                value="0" 
            ) 

        // Ảnh 
        div(
            class="form-group"
            upload-image
        )
            label(for="thumbnail") Ảnh (URL) 
            input( 
                type="file" 
                class="form-control-file"
                id="thumbnail" 
                name="thumbnail" 
                accept="image/*" 
                upload-image-input
            )
            img(
                src=""
                upload-image-preview
                class="image-preview"
            )

        // Vị trí 
        .form-group
            label(for="position") Vị trí 
            input( 
                type="number" 
                class="form-control"
                id="position"
                name="position" 
                min="1" 
                placeholder="Tự động tăng"
            ) 

        // Trạng thái 
        .form-group
            label.d-block Trạng thái 
            .form-check.form-check-inline 
                input.form-check-input( 
                    type="radio" 
                    id="statusActive" 
                    name="status" 
                    value="active" 
                    checked 
                ) 
                label.form-check-label(for="statusActive") Hoạt động 
            
            .form-check.form-check-inline 
                input.form-check-input( 
                    type="radio" 
                    id="statusInactive" 
                    name="status" 
                    value="inactive" 
                ) 
                label.form-check-label(for="statusInactive") Dừng hoạt động
            

        // Nút submit 
        button.btn.btn-primary(type="submit") Tạo sản phẩm
   
    script(src="/admin/js/product.js")