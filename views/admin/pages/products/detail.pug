extends ../../layouts/default.pug

block main
  if product
    - const finalPrice = product.discountPercentage ? product.price * (1 - product.discountPercentage / 100) : product.price
    - const formattedPrice = Math.round(finalPrice || 0).toLocaleString("vi-VN")
    - const formattedOldPrice = Math.round(product.price || 0).toLocaleString("vi-VN")

    .admin-product-detail-page
      .admin-product-detail__topbar
        a.admin-product-detail__back(href=`${prefixAdmin}/products`)
          span(aria-hidden="true") ←
          span Danh sách sản phẩm
        if product.status === "active"
          span.admin-product-detail__status.admin-product-detail__status--active
            i(aria-hidden="true")
            | Đang hoạt động
        else
          span.admin-product-detail__status.admin-product-detail__status--inactive
            i(aria-hidden="true")
            | Đã dừng hoạt động

      .admin-product-detail__heading
        div
          p.admin-page-eyebrow Thông tin sản phẩm
          h1 #{product.title}
          p Xem nhanh hình ảnh, giá bán, tồn kho và nội dung mô tả sản phẩm.
        a.admin-product-detail__edit.admin-product-detail__edit--top(href=`${prefixAdmin}/products/edit/${product.id}`)
          span(aria-hidden="true") ✎
          span Chỉnh sửa sản phẩm

      article.admin-product-detail
        .admin-product-detail__main
          section.admin-product-detail__gallery(aria-label="Hình ảnh sản phẩm")
            .admin-product-detail__image
              if product.thumbnail
                img(src=product.thumbnail alt=product.title)
              else
                .admin-product-detail__image-empty
                  span(aria-hidden="true") ◇
                  strong Chưa có hình ảnh
            span.admin-product-detail__image-label Ảnh đại diện sản phẩm

          section.admin-product-detail__overview
            .admin-product-detail__price-card
              span Giá bán hiện tại
              .admin-product-detail__price-row
                strong #{formattedPrice}đ
                if product.discountPercentage
                  del #{formattedOldPrice}đ
                  span.admin-product-detail__discount -#{product.discountPercentage}%
              if product.discountPercentage
                small Sản phẩm đang được áp dụng chương trình giảm giá.
              else
                small Giá niêm yết hiện tại của sản phẩm.

            .admin-product-detail__stats
              .admin-product-detail__stat
                span Tồn kho
                strong #{product.stock !== undefined ? product.stock : 0}
                small sản phẩm
              .admin-product-detail__stat
                span Vị trí hiển thị
                strong #{product.position !== undefined ? product.position : "—"}
                small thứ tự
              .admin-product-detail__stat
                span Giảm giá
                strong #{product.discountPercentage || 0}%
                small khuyến mãi

            .admin-product-detail__note
              span(aria-hidden="true") i
              p Thông tin này đang được sử dụng trên trang sản phẩm phía khách hàng.

        section.admin-product-detail__description
          .admin-product-detail__section-heading
            div
              span Nội dung hiển thị
              h2 Mô tả sản phẩm
            span.admin-product-detail__section-mark(aria-hidden="true") ≡
          if product.description
            .admin-product-detail__description-content !{product.description}
          else
            .admin-product-detail__description-empty Sản phẩm này chưa có nội dung mô tả.

        footer.admin-product-detail__actions
          a.admin-product-detail__back-button(href=`${prefixAdmin}/products`) Quay lại danh sách
          a.admin-product-detail__edit(href=`${prefixAdmin}/products/edit/${product.id}`)
            span(aria-hidden="true") ✎
            span Chỉnh sửa sản phẩm
  else
    .admin-empty-state
      .admin-empty-state__content
        span.admin-empty-state__icon(aria-hidden="true") ◇
        h1 Không tìm thấy sản phẩm
        p Thông tin sản phẩm không tồn tại hoặc đã được xóa khỏi hệ thống.
        a.btn.btn-primary(href=`${prefixAdmin}/products`) Quay lại danh sách

  script(src="/admin/js/product.js")
