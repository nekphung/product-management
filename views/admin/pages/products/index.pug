extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug
include ../../mixins/alert.pug
include ../../mixins/sort.pug
include ../../mixins/moment.pug 

block main 
    if (role.permissions.includes("products_view"))
        +alert-success(5000)

        h1 Danh sách sản phẩm 

        .card.mb-3.admin-product-controls
            .card-header Bộ lọc, tìm kiếm và sắp xếp
            .card-body
                .admin-product-toolbar
                    .admin-product-toolbar__item.admin-product-toolbar__filter
                        label Trạng thái
                        .admin-status-buttons
                            +filter-status(filterStatus)
                    .admin-product-toolbar__item.admin-product-toolbar__sort
                        label Sắp xếp theo
                        +sort()
                    .admin-product-toolbar__item.admin-product-toolbar__search
                        label Tìm sản phẩm
                        +search(keyword)
        .card.mb-3 
            .card-header.admin-list-header
                span Danh sách
                if (role.permissions.includes("products_create"))
                    a.admin-create-button(href=`${prefixAdmin}/products/create`)
                        span.admin-create-button__icon(aria-hidden="true") +
                        | Thêm mới
            .card-body 
                if (products && products.length > 0)
                    .row 
                        .col-12
                            +form-change-multi(`${prefixAdmin}/products/change-multi?_method=PATCH`)
        
                table(
                    class="table table-hover table-sm"
                    checkbox-multi
                ) 
                    thead 
                        tr 
                            th 
                                input(type="checkbox" name="checkall")
                            th STT 
                            th Hình ảnh
                            th Tiêu đề 
                            th Giá 
                            th Vị trí
                            th Trạng thái
                            th Người tạo
                            th Người cập nhật
                            th Hành động 
                    
                    tbody
                        if (products && products.length > 0)
                          each item, index in products
                            tr 
                                td 
                                    input(
                                        type="checkbox"
                                        name="id"
                                        value=item.id
                                    )
                                td #{pagination.limitItem*(pagination.currentPage - 1) + (index + 1)}
                                td 
                                    img(src=item.thumbnail
                                        alt=item.title
                                        width="100px"
                                        height="auto"
                                    )
                                td #{item.title}
                                td #{item.price}đ
                                td 
                                    input(
                                        type="number"
                                        value=item.position
                                        style="width: 60px"
                                        min="1"
                                        name="position"
                                    )
                                td 
                                    if (role.permissions.includes("products_edit"))
                                        if (item.status == "active")
                                            //- a(href=`/admin/products/change-status/inactive/${item.id}` 
                                            a(
                                            href="javascript:;"
                                            data-status=item.status
                                            data-id=item.id
                                            button-change-status
                                            class="badge badge-success"
                                            ) Hoạt động
                                        else 
                                            a(
                                            href="javascript:;"
                                            data-status=item.status
                                            data-id=item.id
                                            button-change-status
                                            class="badge badge-danger"
                                            ) Dừng hoạt động
                                td 
                                    p #{item.accountFullName}
                                    p 
                                        +formatDate(item.createdBy.createdAt)
                                td  
                                    - const updatedBy = item.updatedBy.slice(-1)[0];
                                    if (updatedBy)
                                        p #{updatedBy.accountFullName}
                                        p 
                                            +formatDate(updatedBy.updatedAt) 
                                td  
                                    a(
                                        href=`${prefixAdmin}/products/detail/${item.id}`
                                        class="btn btn-secondary btn-sm"
                                    ) Chi tiết
                                    if (role.permissions.includes("products_edit"))
                                        a(
                                            href=`${prefixAdmin}/products/edit/${item.id}`
                                            class="btn btn-warning btn-sm"
                                        ) Sửa
                                    if (role.permissions.includes("products_delete"))
                                        button(
                                            class="btn btn-danger btn-sm ml-1"
                                            button-delete
                                            data-id=item.id
                                        ) Xóa
                        else
                          tr
                            td.admin-empty-state(colspan="10")
                              .admin-empty-state__content
                                .admin-empty-state__visual(aria-hidden="true")
                                  svg(viewBox="0 0 64 64")
                                    path(d="M13 22 32 12l19 10-19 10-19-10Z")
                                    path(d="m13 22 19 10 19-10v21L32 53 13 43V22Z")
                                    path(d="M32 32v21")
                                    path(d="M43 17 24 27")
                                  span +
                                p.admin-empty-state__eyebrow Kho sản phẩm đang trống
                                strong Chưa có sản phẩm nào
                                small Tạo sản phẩm đầu tiên để bắt đầu quản lý tồn kho, giá bán và nội dung hiển thị trên cửa hàng.
                                .admin-empty-state__features
                                  span
                                    i(aria-hidden="true") ✓
                                    | Quản lý giá và tồn kho
                                  span
                                    i(aria-hidden="true") ✓
                                    | Hiển thị ngay ngoài cửa hàng
                                if (role.permissions.includes("products_create"))
                                  a.admin-empty-state__action(href=`${prefixAdmin}/products/create`)
                                    span(aria-hidden="true") +
                                    | Thêm sản phẩm đầu tiên

        +pagination(pagination)

        form(
            action=""
            method="POST"
            id="form-change-status"
            data-path=`${prefixAdmin}/products/change-status`
        )

        form(
            action=""
            method="POST"
            id="form-delete-item"
            data-path=`${prefixAdmin}/products/delete`
        )
        

        script(src="/admin/js/product.js")
