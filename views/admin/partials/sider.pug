aside.sider
  .admin-sidebar__brand
    a(href=`${prefixAdmin}/dashboard` aria-label="Trang quản trị Nèk Phùng")
      strong NP
      span Nèk Phùng
  nav.inner-menu(aria-label="Điều hướng quản trị")
    ul
      li
        a(href=`${prefixAdmin}/dashboard` data-admin-nav)
          span.admin-nav-icon(aria-hidden="true") ◴
          span Tổng quan
      if (role.permissions.includes("products-category_view"))
        li
          a(href=`${prefixAdmin}/products-category` data-admin-nav)
            span.admin-nav-icon(aria-hidden="true") ▤
            span Danh mục sản phẩm
      if (role.permissions.includes("products_view"))
        li
          a(href=`${prefixAdmin}/products` data-admin-nav)
            span.admin-nav-icon(aria-hidden="true") ◇
            span Sản phẩm
      if (role.permissions.includes("roles_view"))
        li
          a(href=`${prefixAdmin}/roles` data-admin-nav)
            span.admin-nav-icon(aria-hidden="true") ♧
            span Nhóm quyền
      if (role.permissions.includes("roles_permissions"))
        li
          a(href=`${prefixAdmin}/roles/permissions` data-admin-nav)
            span.admin-nav-icon(aria-hidden="true") ⎇
            span Phân quyền
      if (role.permissions.includes("accounts_view"))
        li
          a(href=`${prefixAdmin}/accounts` data-admin-nav)
            span.admin-nav-icon(aria-hidden="true") ♙
            span Tài khoản
      li
        a(href=`${prefixAdmin}/settings/general` data-admin-nav)
          span.admin-nav-icon(aria-hidden="true") ⚙
          span Cài đặt chung
