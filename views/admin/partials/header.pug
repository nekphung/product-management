header.admin-header
  .admin-header__brand
    button.admin-menu-toggle(type="button" data-sidebar-toggle aria-label="Mở menu quản trị")
      span
      span
      span
    a(href=`${prefixAdmin}/dashboard`) Admin Panel
  .admin-header__actions
    a.admin-header__account(href=`${prefixAdmin}/my-account`)
      if user.avatar
        img.admin-header__avatar.admin-header__avatar--image(src=user.avatar alt=`Ảnh đại diện của ${user.fullName || "quản trị viên"}` onerror="this.hidden=true;this.nextElementSibling.hidden=false")
        span.admin-header__avatar(hidden) #{user.fullName ? user.fullName.charAt(0).toUpperCase() : "A"}
      else
        span.admin-header__avatar #{user.fullName ? user.fullName.charAt(0).toUpperCase() : "A"}
      span #{user.fullName}
    a.admin-header__logout(href=`${prefixAdmin}/auth/logout`) Đăng xuất
